include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/WindowsTools.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/OpenSSLProfiles.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/OpenSSLInput.cmake")

# Standalone driver. Consumer search/cache publication is handled separately.
function(cc_build_openssl)
    if(ANDROID OR CMAKE_SYSTEM_NAME MATCHES "^(Linux|Darwin|iOS|tvOS)$")
        include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/BuildOpenSSLPortable.cmake")
        cc_build_openssl_portable()
        foreach(name STAGE INPUT CONFIGURATION CONFIGURATIONS DEBUG_STAGE DEBUG_INPUT RELEASE_STAGE RELEASE_INPUT)
            set(CC_OPENSSL_${name} "${CC_OPENSSL_${name}}" PARENT_SCOPE)
        endforeach()
        return()
    endif()
    ossl_select_input(source bundled_source)
    set(CC_OPENSSL_WORK_ROOT "${CMAKE_BINARY_DIR}/openssl-work" CACHE PATH "Isolated OpenSSL build and stage root")
    set(CC_OPENSSL_PERL "" CACHE FILEPATH "Native Windows Perl executable")
    set(CC_OPENSSL_MAKE "" CACHE FILEPATH "Optional exact nmake path from selected VS")
    set(CC_OPENSSL_BACKEND "nmake" CACHE STRING "Windows OpenSSL make backend")
    set_property(CACHE CC_OPENSSL_BACKEND PROPERTY STRINGS nmake jom)
    set(CC_OPENSSL_JOM "" CACHE FILEPATH "Explicit local jom executable; never downloaded")
    set(CC_OPENSSL_JOBS "8" CACHE STRING "Maximum jom compile jobs (1 through 8); nmake uses 1")
    get_filename_component(cocos_default "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
    set(CC_OPENSSL_COCOS_ROOT "${cocos_default}")
    ossl_configure_options(peripheral OFF OFF options)
    # Keep legacy built into libcrypto instead of shipping a provider DLL.
    list(APPEND options no-module)
    if(NOT CMAKE_CONFIGURATION_TYPES STREQUAL "Debug;Release" AND NOT CMAKE_CONFIGURATION_TYPES STREQUAL "Debug")
        message(FATAL_ERROR "Set CMAKE_CONFIGURATION_TYPES=Debug;Release or Debug explicitly; no other configurations are prepared")
    endif()
    if(CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
        message(FATAL_ERROR "OpenSSL shared Debug/Release require the parent /MDd and /MD CRT mapping")
    endif()
    foreach(name WORK_ROOT COCOS_ROOT)
        ossl_safe_value("${CC_OPENSSL_${name}}")
        if(NOT IS_ABSOLUTE "${CC_OPENSSL_${name}}")
            message(FATAL_ERROR "CC_OPENSSL_${name} must be an absolute local path")
        endif()
    endforeach()
    ossl_resolve_path("${CC_OPENSSL_WORK_ROOT}" work)
    if(bundled_source)
        cmake_path(IS_PREFIX bundled_source "${work}" NORMALIZE inside_bundled)
        cmake_path(IS_PREFIX work "${bundled_source}" NORMALIZE contains_bundled)
        if(inside_bundled OR contains_bundled)
            message(FATAL_ERROR "OpenSSL work root must not overlap the bundled source tree")
        endif()
    endif()
    cmake_path(IS_PREFIX source "${work}" NORMALIZE nested)
    cmake_path(IS_PREFIX work "${source}" NORMALIZE reverse_nested)
    if(nested OR reverse_nested OR NOT EXISTS "${source}/Configure" OR EXISTS "${source}/configdata.pm")
        message(FATAL_ERROR "Use an unconfigured source snapshot and a separate non-overlapping work root")
    endif()
    ossl_validate_source("${source}" pruned peripheral OFF OFF source_hash source_inventory)
    ossl_windows_tools()
    ossl_adapter_hash(adapter_hash)
    string(SHA256 profile_hash "${source}\n${source_hash}\nperipheral\n${options}\nshared\n${adapter_hash}")
    string(SUBSTRING "${profile_hash}" 0 16 source_key)
    string(SUBSTRING "${OSSL_TOOL_HASH}" 0 16 tool_key)
    set(base "${work}/${source_key}/${tool_key}/windows-${OSSL_ARCH}")
    file(MAKE_DIRECTORY "${base}")
    ossl_write_if_changed("${base}/source-files.sha256" "${source_inventory}")
    ossl_write_if_changed("${base}/toolchain.txt" "${OSSL_TOOL_IDENTITY}")
    set(driver "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/cmake/RunOpenSSL.cmake")
    foreach(config IN LISTS CMAKE_CONFIGURATION_TYPES)
        set(root "${base}/${config}")
        set(stage "${root}/stage")
        if(config STREQUAL "Debug")
            set(crt /MDd)
        else()
            set(crt /MD)
        endif()
        string(SHA256 id "${profile_hash}\n${OSSL_TOOL_HASH}\n${config}\n${root}\n${OSSL_TARGET}\n${crt}")
        set(descriptor "")
        foreach(pair "SOURCE|${source}" "BUNDLED_SOURCE|${bundled_source}" "SOURCE_HASH|${source_hash}" "ADAPTER_HASH|${adapter_hash}"
            "ID|${id}" "ROOT|${root}" "STAGE|${stage}" "CONFIG|${config}" "PROFILE|peripheral"
            "SOURCE_LAYOUT|pruned" "BUILD_TESTS|OFF" "BUILD_DEMOS|OFF"
            "ARCH|${OSSL_ARCH}" "HOST_ARCH|${OSSL_HOST_ARCH}" "TARGET|${OSSL_TARGET}"
            "VCVARS_ARCH|${OSSL_VCVARS_ARCH}" "DLL_SUFFIX|${OSSL_DLL_SUFFIX}" "USE_NASM|${OSSL_USE_NASM}"
            "PERL|${OSSL_PERL}" "NASM|${OSSL_NASM}" "VCVARS|${OSSL_VCVARS}"
            "VCARGS|${OSSL_VCARGS}" "MAKE|${OSSL_MAKE}" "NMAKE|${OSSL_NMAKE}" "POWERSHELL|${OSSL_POWERSHELL}"
            "BACKEND|${OSSL_BACKEND}" "JOBS|${OSSL_JOBS}" "EXTRA_CFLAGS|${OSSL_EXTRA_CFLAGS}"
            "MAKE_VERSION|${OSSL_MAKE_VERSION}" "TOOL_RECORDS|${OSSL_TOOL_RECORDS}")
            string(FIND "${pair}" "|" split)
            string(SUBSTRING "${pair}" 0 ${split} name)
            math(EXPR split "${split}+1")
            string(SUBSTRING "${pair}" ${split} -1 value)
            string(APPEND descriptor "set(OSSL_${name} [===[${value}]===])\n")
        endforeach()
        string(APPEND descriptor "set(OSSL_OPTIONS [===[${options}]===])\n")
        file(MAKE_DIRECTORY "${root}")
        ossl_write_if_changed("${root}/input.cmake" "${descriptor}")
        message(STATUS "Preparing OpenSSL ${OSSL_TARGET} ${config}: ${root}")
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${root}/input.cmake" -DMODE=BOOTSTRAP -P "${driver}" RESULT_VARIABLE rc)
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "OpenSSL ${config} preparation failed; inspect ${root}/logs")
        endif()
        set(stage_${config} "${stage}")
        set(input_${config} "${root}/input.cmake")
    endforeach()
    # Generated feature macros must agree before a shared consumer probe is used.
    set(selected_stage "${stage_Debug}")
    set(selected_input "${input_Debug}")
    if("Release" IN_LIST CMAKE_CONFIGURATION_TYPES)
        file(SHA256 "${stage_Debug}/include/openssl/configuration.h" debug_macros)
        file(SHA256 "${stage_Release}/include/openssl/configuration.h" release_macros)
        if(NOT debug_macros STREQUAL release_macros)
            message(FATAL_ERROR "Debug and Release public feature headers differ; use separate consumer build directories")
        endif()
        set(selected_stage "$<IF:$<CONFIG:Debug>,${stage_Debug},${stage_Release}>")
        set(selected_input "$<IF:$<CONFIG:Debug>,${input_Debug},${input_Release}>")
    endif()
    set(byproducts "")
    foreach(file include/openssl/configuration.h include/openssl/opensslv.h lib/libcrypto.lib lib/libssl.lib
        "bin/libcrypto-3${OSSL_DLL_SUFFIX}.dll" "bin/libssl-3${OSSL_DLL_SUFFIX}.dll")
        list(APPEND byproducts "${selected_stage}/${file}")
    endforeach()
    add_custom_target(cc_openssl_build
        COMMAND "${CMAKE_COMMAND}" "-DINPUT=${selected_input}" -DMODE=BUILD -P "${driver}"
        BYPRODUCTS ${byproducts} VERBATIM)
    foreach(lib Crypto SSL)
        string(TOLOWER "${lib}" lower)
        if(TARGET OpenSSL::${lib})
            message(FATAL_ERROR "OpenSSL::${lib} already exists; do not mix old and new entries")
        endif()
        add_library(OpenSSL::${lib} SHARED IMPORTED GLOBAL)
        set_target_properties(OpenSSL::${lib} PROPERTIES IMPORTED_CONFIGURATIONS "${CMAKE_CONFIGURATION_TYPES}"
            INTERFACE_INCLUDE_DIRECTORIES "${selected_stage}/include")
        foreach(config IN LISTS CMAKE_CONFIGURATION_TYPES)
            string(TOUPPER "${config}" upper)
            set_target_properties(OpenSSL::${lib} PROPERTIES
                IMPORTED_LOCATION_${upper} "${stage_${config}}/bin/lib${lower}-3${OSSL_DLL_SUFFIX}.dll"
                IMPORTED_IMPLIB_${upper} "${stage_${config}}/lib/lib${lower}.lib")
        endforeach()
        add_dependencies(OpenSSL::${lib} cc_openssl_build)
    endforeach()
    set_property(TARGET OpenSSL::SSL PROPERTY INTERFACE_LINK_LIBRARIES OpenSSL::Crypto)
    set(CC_OPENSSL_DEBUG_STAGE "${stage_Debug}" PARENT_SCOPE)
    set(CC_OPENSSL_RELEASE_STAGE "${stage_Release}" PARENT_SCOPE)
    set(CC_OPENSSL_DEBUG_INPUT "${input_Debug}" PARENT_SCOPE)
    set(CC_OPENSSL_RELEASE_INPUT "${input_Release}" PARENT_SCOPE)
    # OpenSSLInput tracks the real input tree, including bundled files/directories.
    file(GLOB adapters CONFIGURE_DEPENDS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/cmake/*.cmake"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/cmake/*.ps1"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/cmake/*.pl")
    ossl_add_configure_dependencies(${adapters}
        "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/source-manifest.json"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/prune-manifest.json" ${OSSL_TOOLS})
endfunction()
