include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/PortableTools.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/OpenSSLProfiles.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/OpenSSLSource.cmake")

function(cc_build_openssl_portable)
    set(CC_OPENSSL_SOURCE_DIR "" CACHE PATH "Local fixed OpenSSL 3.5.9 source snapshot")
    set(CC_OPENSSL_WORK_ROOT "${CMAKE_BINARY_DIR}/openssl-work" CACHE PATH "Isolated OpenSSL build and stage root")
    set(CC_OPENSSL_PROFILE "peripheral" CACHE STRING "OpenSSL feature profile")
    set(CC_OPENSSL_SOURCE_LAYOUT "full" CACHE STRING "OpenSSL source layout: full or pruned")
    set(CC_OPENSSL_BUILD_TESTS OFF CACHE BOOL "Keep upstream OpenSSL tests enabled")
    set(CC_OPENSSL_BUILD_DEMOS OFF CACHE BOOL "Keep upstream OpenSSL demos enabled")
    ossl_configure_options("${CC_OPENSSL_PROFILE}" "${CC_OPENSSL_BUILD_TESTS}" "${CC_OPENSSL_BUILD_DEMOS}" options)
    ossl_portable_tools()
    foreach(name SOURCE_DIR WORK_ROOT)
        ossl_safe_value("${CC_OPENSSL_${name}}")
        if(NOT IS_ABSOLUTE "${CC_OPENSSL_${name}}")
            message(FATAL_ERROR "CC_OPENSSL_${name} must be an absolute local path")
        endif()
    endforeach()
    ossl_resolve_path("${CC_OPENSSL_SOURCE_DIR}" source)
    ossl_resolve_path("${CC_OPENSSL_WORK_ROOT}" work)
    cmake_path(IS_PREFIX source "${work}" NORMALIZE nested)
    cmake_path(IS_PREFIX work "${source}" NORMALIZE reverse_nested)
    if(nested OR reverse_nested)
        message(FATAL_ERROR "Portable OpenSSL requires non-overlapping source and work directories")
    endif()
    ossl_validate_source("${source}" "${CC_OPENSSL_SOURCE_LAYOUT}" "${CC_OPENSSL_PROFILE}"
        "${CC_OPENSSL_BUILD_TESTS}" "${CC_OPENSSL_BUILD_DEMOS}" source_hash source_inventory)
    ossl_adapter_hash(adapter_hash)
    string(SHA256 profile_hash "${source}\n${source_hash}\n${CC_OPENSSL_PROFILE}\n${CC_OPENSSL_SOURCE_LAYOUT}\n${options}\n${OSSL_PLATFORM_OPTIONS}\n${adapter_hash}")
    string(SUBSTRING "${profile_hash}" 0 16 source_key)
    string(SUBSTRING "${OSSL_TOOL_HASH}" 0 16 tool_key)
    set(base "${work}/${source_key}/${tool_key}/${OSSL_TARGET_KEY}")
    set(root "${base}/${CMAKE_BUILD_TYPE}")
    set(stage "${root}/stage")
    file(MAKE_DIRECTORY "${root}")
    ossl_write_if_changed("${base}/source-files.sha256" "${source_inventory}")
    ossl_write_if_changed("${base}/toolchain.txt" "${OSSL_TOOL_IDENTITY}")
    string(SHA256 id "${profile_hash}\n${OSSL_TOOL_HASH}\n${CMAKE_BUILD_TYPE}\n${root}\n${OSSL_TARGET}\n${OSSL_RUNTIME_OPENSSLDIR}")
    set(descriptor "")
    foreach(pair "SOURCE|${source}" "SOURCE_HASH|${source_hash}" "ADAPTER_HASH|${adapter_hash}"
        "ID|${id}" "ROOT|${root}" "STAGE|${stage}" "CONFIG|${CMAKE_BUILD_TYPE}" "PROFILE|${CC_OPENSSL_PROFILE}"
        "SOURCE_LAYOUT|${CC_OPENSSL_SOURCE_LAYOUT}" "BUILD_TESTS|${CC_OPENSSL_BUILD_TESTS}" "BUILD_DEMOS|${CC_OPENSSL_BUILD_DEMOS}"
        "PERL|${OSSL_PERL}" "MAKE|${OSSL_MAKE}" "JOBS|${OSSL_JOBS}" "TARGET|${OSSL_TARGET}"
        "PLATFORM_OPTIONS|${OSSL_PLATFORM_OPTIONS}" "ENVIRONMENT|${OSSL_ENVIRONMENT}"
        "RUNTIME_OPENSSLDIR|${OSSL_RUNTIME_OPENSSLDIR}" "READELF|${OSSL_READELF}" "NM|${OSSL_NM}" "LIPO|${OSSL_LIPO}"
        "COMPILER|${OSSL_COMPILER}" "TOOL_RECORDS|${OSSL_TOOL_RECORDS}" "OPTIONS|${options}")
        string(FIND "${pair}" "|" split)
        string(SUBSTRING "${pair}" 0 ${split} name)
        math(EXPR split "${split}+1")
        string(SUBSTRING "${pair}" ${split} -1 value)
        string(APPEND descriptor "set(OSSL_${name} [===[${value}]===])\n")
    endforeach()
    foreach(name WINDOWS_ANDROID MSYS_ROOT MSYS_PERL5LIB MSYS_MODULES_HASH ANDROID_NDK POWERSHELL)
        string(APPEND descriptor "set(OSSL_${name} [===[${OSSL_${name}}]===])\n")
    endforeach()
    ossl_write_if_changed("${root}/input.cmake" "${descriptor}")
    set(driver "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/cmake/RunOpenSSLPortable.cmake")
    message(STATUS "Preparing OpenSSL 3.5.9 ${CMAKE_BUILD_TYPE} ${OSSL_TARGET}: ${root}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${root}/input.cmake" -DMODE=BOOTSTRAP -P "${driver}" RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Portable OpenSSL preparation failed; inspect ${root}/logs")
    endif()
    add_custom_target(cc_openssl_build
        COMMAND "${CMAKE_COMMAND}" "-DINPUT=${root}/input.cmake" -DMODE=BUILD -P "${driver}"
        BYPRODUCTS "${stage}/include/openssl/configuration.h" "${stage}/include/openssl/opensslv.h"
            "${stage}/lib/libcrypto.a" "${stage}/lib/libssl.a" VERBATIM)
    find_package(Threads REQUIRED)
    foreach(component Crypto SSL)
        if(TARGET OpenSSL::${component})
            message(FATAL_ERROR "OpenSSL::${component} already exists; do not mix dependency identities")
        endif()
        string(TOLOWER "${component}" library)
        add_library(OpenSSL::${component} STATIC IMPORTED GLOBAL)
        set_target_properties(OpenSSL::${component} PROPERTIES IMPORTED_LOCATION "${stage}/lib/lib${library}.a"
            INTERFACE_INCLUDE_DIRECTORIES "${stage}/include")
        add_dependencies(OpenSSL::${component} cc_openssl_build)
    endforeach()
    set_property(TARGET OpenSSL::Crypto PROPERTY INTERFACE_LINK_LIBRARIES "${OSSL_SYSTEM_LIBRARIES}")
    set_property(TARGET OpenSSL::SSL PROPERTY INTERFACE_LINK_LIBRARIES OpenSSL::Crypto)
    set(CC_OPENSSL_STAGE "${stage}" PARENT_SCOPE)
    set(CC_OPENSSL_INPUT "${root}/input.cmake" PARENT_SCOPE)
    set(CC_OPENSSL_CONFIGURATION "${CMAKE_BUILD_TYPE}" PARENT_SCOPE)
    file(GLOB_RECURSE inputs CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE "${source}/*" "${source}/.*")
    file(REAL_PATH "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/cmake" adapter_root)
    file(GLOB adapters CONFIGURE_DEPENDS "${adapter_root}/*.cmake" "${adapter_root}/*.pl")
    set(configure_inputs ${inputs} ${adapters} ${OSSL_TOOLS}
        "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/source-manifest.json"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/prune-manifest.json")
    set(normalized_inputs)
    foreach(input IN LISTS configure_inputs)
        file(REAL_PATH "${input}" normalized)
        list(APPEND normalized_inputs "${normalized}")
    endforeach()
    list(REMOVE_DUPLICATES normalized_inputs)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${normalized_inputs})
endfunction()
