include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/PortableTools.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/OpenSSLPortableFlags.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/OpenSSLProfiles.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/OpenSSLInput.cmake")

function(cc_build_openssl_portable)
    ossl_portable_configurations(configurations)
    ossl_select_input(source bundled_source)
    set(CC_OPENSSL_WORK_ROOT "${CMAKE_BINARY_DIR}/openssl-work" CACHE PATH "Isolated OpenSSL build and stage root")
    ossl_configure_options(peripheral OFF OFF options)
    foreach(name WORK_ROOT)
        ossl_safe_value("${CC_OPENSSL_${name}}")
        if(NOT IS_ABSOLUTE "${CC_OPENSSL_${name}}")
            message(FATAL_ERROR "CC_OPENSSL_${name} must be an absolute local path")
        endif()
    endforeach()
    ossl_resolve_path("${CC_OPENSSL_WORK_ROOT}" work)
    if(bundled_source)
        cmake_path(IS_PREFIX bundled_source "${work}" NORMALIZE inside_bundled)
        cmake_path(IS_PREFIX work "${bundled_source}" NORMALIZE contains_bundled)
        if(inside_bundled OR contains_bundled)
            message(FATAL_ERROR "OpenSSL work root must not overlap the bundled source tree")
        endif()
    endif()
    cmake_path(IS_PREFIX source "${work}" NORMALIZE nested)
    cmake_path(IS_PREFIX work "${source}" NORMALIZE reverse_nested)
    if(nested OR reverse_nested)
        message(FATAL_ERROR "Portable OpenSSL requires non-overlapping source and work directories")
    endif()
    ossl_validate_source("${source}" pruned peripheral OFF OFF source_hash source_inventory)
    ossl_portable_tools()
    ossl_adapter_hash(adapter_hash)
    string(SHA256 profile_hash "${source}\n${source_hash}\nperipheral\npruned\n${options}\n${OSSL_PLATFORM_OPTIONS}\n${adapter_hash}")
    string(SUBSTRING "${profile_hash}" 0 16 source_key)
    string(SUBSTRING "${OSSL_TOOL_HASH}" 0 16 tool_key)
    set(base "${work}/${source_key}/${tool_key}/${OSSL_TARGET_KEY}")
    file(MAKE_DIRECTORY "${base}")
    ossl_write_if_changed("${base}/source-files.sha256" "${source_inventory}")
    ossl_write_if_changed("${base}/toolchain.txt" "${OSSL_TOOL_IDENTITY}")
    set(driver "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/cmake/RunOpenSSLPortable.cmake")
    set(common_platform_options "${OSSL_PLATFORM_OPTIONS}")
    set(common_compiler_flags "${OSSL_COMPILER_FLAGS}")
    set(common_environment "${OSSL_ENVIRONMENT}")
    set(selected_stage "")
    set(selected_input "")
    set(byproducts)
    set(first_headers "")
    foreach(config IN LISTS configurations)
        string(TOUPPER "${config}" upper)
        set(root "${base}/${config}")
        set(stage "${root}/stage")
        file(MAKE_DIRECTORY "${root}")
        separate_arguments(config_flags UNIX_COMMAND "${CMAKE_C_FLAGS_${upper}}")
        set(compiler_flags ${common_compiler_flags} ${config_flags})
        ossl_portable_encode_flags(compiler_flags encoded_flags)
        set(OSSL_PLATFORM_OPTIONS ${common_platform_options} "${encoded_flags}")
        string(STRIP "${CMAKE_EXE_LINKER_FLAGS} ${CMAKE_EXE_LINKER_FLAGS_${upper}}" linker_flags)
        set(OSSL_ENVIRONMENT ${common_environment} "LDFLAGS=${linker_flags}")
        string(SHA256 id "${profile_hash}\n${OSSL_TOOL_HASH}\n${config}\n${root}\n${OSSL_TARGET}\n${OSSL_RUNTIME_OPENSSLDIR}\n${OSSL_PLATFORM_OPTIONS}\n${OSSL_ENVIRONMENT}")
        set(descriptor "")
        foreach(pair "SOURCE|${source}" "BUNDLED_SOURCE|${bundled_source}" "SOURCE_HASH|${source_hash}" "ADAPTER_HASH|${adapter_hash}"
            "ID|${id}" "ROOT|${root}" "STAGE|${stage}" "CONFIG|${config}" "PROFILE|peripheral"
            "SOURCE_LAYOUT|pruned" "BUILD_TESTS|OFF" "BUILD_DEMOS|OFF"
            "PERL|${OSSL_PERL}" "MAKE|${OSSL_MAKE}" "JOBS|${OSSL_JOBS}" "TARGET|${OSSL_TARGET}"
            "PLATFORM_OPTIONS|${OSSL_PLATFORM_OPTIONS}" "ENVIRONMENT|${OSSL_ENVIRONMENT}"
            "RUNTIME_OPENSSLDIR|${OSSL_RUNTIME_OPENSSLDIR}" "READELF|${OSSL_READELF}" "NM|${OSSL_NM}" "LIPO|${OSSL_LIPO}"
            "COMPILER|${OSSL_COMPILER}" "TOOL_RECORDS|${OSSL_TOOL_RECORDS}" "OPTIONS|${options}"
            "ARCH|${OSSL_ARCH}" "FORMAT|${OSSL_FORMAT}" "ELF_CLASS|${OSSL_ELF_CLASS}" "ELF_MACHINE|${OSSL_ELF_MACHINE}"
            "NM_OPTIONS|${OSSL_NM_OPTIONS}")
            string(FIND "${pair}" "|" split)
            string(SUBSTRING "${pair}" 0 ${split} name)
            math(EXPR split "${split}+1")
            string(SUBSTRING "${pair}" ${split} -1 value)
            string(APPEND descriptor "set(OSSL_${name} [===[${value}]===])\n")
        endforeach()
        foreach(name WINDOWS_ANDROID MSYS_ROOT MSYS_PERL5LIB MSYS_MODULES_HASH ANDROID_NDK POWERSHELL)
            string(APPEND descriptor "set(OSSL_${name} [===[${OSSL_${name}}]===])\n")
        endforeach()
        ossl_write_if_changed("${root}/input.cmake" "${descriptor}")
        message(STATUS "Preparing OpenSSL ${config} ${OSSL_TARGET}: ${root}")
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${root}/input.cmake" -DMODE=BOOTSTRAP -P "${driver}" RESULT_VARIABLE rc)
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "Portable OpenSSL ${config} preparation failed; inspect ${root}/logs")
        endif()
        file(SHA256 "${stage}/include/openssl/configuration.h" feature_hash)
        if(first_headers AND NOT first_headers STREQUAL feature_hash)
            message(FATAL_ERROR "OpenSSL Debug/Release public feature headers differ; use separate build directories")
        endif()
        set(first_headers "${feature_hash}")
        set(CC_OPENSSL_${upper}_STAGE "${stage}" PARENT_SCOPE)
        set(CC_OPENSSL_${upper}_INPUT "${root}/input.cmake" PARENT_SCOPE)
        set(stage_${upper} "${stage}")
        if(CMAKE_CONFIGURATION_TYPES)
            string(APPEND selected_stage "$<$<CONFIG:${config}>:${stage}>")
            string(APPEND selected_input "$<$<CONFIG:${config}>:${root}/input.cmake>")
            foreach(file include/openssl/configuration.h include/openssl/opensslv.h lib/libcrypto.a lib/libssl.a)
                list(APPEND byproducts "$<$<CONFIG:${config}>:${stage}/${file}>")
            endforeach()
        else()
            set(selected_stage "${stage}")
            set(selected_input "${root}/input.cmake")
            foreach(file include/openssl/configuration.h include/openssl/opensslv.h lib/libcrypto.a lib/libssl.a)
                list(APPEND byproducts "${stage}/${file}")
            endforeach()
        endif()
    endforeach()
    add_custom_target(cc_openssl_build
        COMMAND "${CMAKE_COMMAND}" "-DINPUT=${selected_input}" -DMODE=BUILD -P "${driver}"
        BYPRODUCTS ${byproducts} VERBATIM)
    find_package(Threads REQUIRED)
    foreach(component Crypto SSL)
        if(TARGET OpenSSL::${component})
            message(FATAL_ERROR "OpenSSL::${component} already exists; do not mix dependency identities")
        endif()
        string(TOLOWER "${component}" library)
        add_library(OpenSSL::${component} STATIC IMPORTED GLOBAL)
        set_target_properties(OpenSSL::${component} PROPERTIES IMPORTED_CONFIGURATIONS "${configurations}"
            INTERFACE_INCLUDE_DIRECTORIES "${selected_stage}/include")
        foreach(config IN LISTS configurations)
            string(TOUPPER "${config}" upper)
            set_property(TARGET OpenSSL::${component} PROPERTY IMPORTED_LOCATION_${upper} "${stage_${upper}}/lib/lib${library}.a")
        endforeach()
        if(NOT CMAKE_CONFIGURATION_TYPES)
            set_property(TARGET OpenSSL::${component} PROPERTY IMPORTED_LOCATION "${selected_stage}/lib/lib${library}.a")
        endif()
        add_dependencies(OpenSSL::${component} cc_openssl_build)
    endforeach()
    set_property(TARGET OpenSSL::Crypto PROPERTY INTERFACE_LINK_LIBRARIES "${OSSL_SYSTEM_LIBRARIES}")
    set_property(TARGET OpenSSL::SSL PROPERTY INTERFACE_LINK_LIBRARIES OpenSSL::Crypto)
    set(CC_OPENSSL_STAGE "${selected_stage}" PARENT_SCOPE)
    set(CC_OPENSSL_INPUT "${selected_input}" PARENT_SCOPE)
    set(CC_OPENSSL_CONFIGURATION "${configurations}" PARENT_SCOPE)
    set(CC_OPENSSL_CONFIGURATIONS "${configurations}" PARENT_SCOPE)
    # OpenSSLInput tracks the real input tree, including bundled files/directories.
    file(REAL_PATH "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/cmake" adapter_root)
    file(GLOB adapters CONFIGURE_DEPENDS "${adapter_root}/*.cmake" "${adapter_root}/*.pl")
    set(configure_inputs ${adapters} ${OSSL_TOOLS}
        "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/source-manifest.json"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl/prune-manifest.json")
    set(normalized_inputs)
    foreach(input IN LISTS configure_inputs)
        file(REAL_PATH "${input}" normalized)
        list(APPEND normalized_inputs "${normalized}")
    endforeach()
    list(REMOVE_DUPLICATES normalized_inputs)
    ossl_add_configure_dependencies(${normalized_inputs})
endfunction()
