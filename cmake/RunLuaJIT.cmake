cmake_minimum_required(VERSION 3.20)
include("${SETTINGS}")
if(NOT CONFIG MATCHES "^(Debug|Release)$")
    message(FATAL_ERROR "Invalid LuaJIT configuration: ${CONFIG}")
endif()
set(work "${lj_root}/${CONFIG}")
file(MAKE_DIRECTORY "${work}")
file(LOCK "${work}/build.lock" GUARD PROCESS TIMEOUT 600)
if(NOT EXISTS "${work}/snapshot.ready")
    file(COPY "${lj_source}/src" "${lj_source}/dynasm" "${lj_source}/COPYRIGHT" DESTINATION "${work}")
    file(WRITE "${work}/.relver" "${lj_relver}\n")
    file(WRITE "${work}/snapshot.ready" "${lj_relver}\n")
endif()
set(outputs "${work}/src/luajit.h" "${work}/src/jit/vmdef.lua")
if(lj_windows)
    list(APPEND outputs "${work}/src/lua51.dll" "${work}/src/lua51.lib" "${work}/src/luajit.exe")
    set(ready TRUE)
    foreach(output IN LISTS outputs)
        if(NOT EXISTS "${output}")
            set(ready FALSE)
        endif()
    endforeach()
    if(ready AND EXISTS "${work}/build.ready")
        return()
    endif()
    set(debug_arg "")
    if(CONFIG STREQUAL "Debug")
        set(debug_arg debug)
    endif()
    file(TO_NATIVE_PATH "${lj_vcvars}" vcvars)
    file(WRITE "${work}/build.cmd" "@echo off\r\ncall \"${vcvars}\" ${lj_vcarch} >nul\r\nif errorlevel 1 exit /b 1\r\ncall msvcbuild.bat ${debug_arg}\r\n")
    execute_process(COMMAND cmd /c "${work}/build.cmd" WORKING_DIRECTORY "${work}/src"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    # msvcbuild.bat does not consistently preserve a failing errorlevel.
    if(NOT output MATCHES "Successfully built LuaJIT")
        set(result 1)
    endif()
else()
    set(debug_args "CCDEBUG=" "CCOPT=-O2 -fomit-frame-pointer")
    if(CONFIG STREQUAL "Debug")
        set(debug_args "CCDEBUG=-g" "CCOPT=-O0 -fno-omit-frame-pointer")
    endif()
    list(APPEND outputs "${work}/src/libluajit.a")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${lj_environment}
        "${lj_make}" -C "${work}/src" "-j${lj_jobs}" ${lj_make_args} ${debug_args}
        libluajit.a jit/vmdef.lua
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
endif()
file(WRITE "${work}/build.stdout.log" "${output}")
file(WRITE "${work}/build.stderr.log" "${error}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "LuaJIT build failed (${result}). See ${work}/build.*.log\n${output}\n${error}")
endif()
foreach(output IN LISTS outputs)
    if(NOT EXISTS "${output}")
        message(FATAL_ERROR "LuaJIT did not produce ${output}")
    endif()
endforeach()
file(WRITE "${work}/build.ready" "${CONFIG} ${lj_relver}\n")
