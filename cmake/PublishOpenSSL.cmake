cmake_minimum_required(VERSION 3.28)
include("${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/OpenSSLCommon.cmake")
if(NOT DEFINED INPUT OR NOT EXISTS "${INPUT}" OR NOT DEFINED DESTINATION OR NOT IS_ABSOLUTE "${DESTINATION}")
    message(FATAL_ERROR "Pass -DINPUT=<driver input.cmake> -DDESTINATION=<absolute consumer stage>")
endif()
include("${INPUT}")
ossl_safe_value("${DESTINATION}")
ossl_resolve_path("${DESTINATION}" DESTINATION)
foreach(protected "${OSSL_ROOT}" "${OSSL_SOURCE}")
    cmake_path(IS_PREFIX protected "${DESTINATION}" NORMALIZE overlaps)
    cmake_path(IS_PREFIX DESTINATION "${protected}" NORMALIZE contains_input)
    if(overlaps OR contains_input)
        message(FATAL_ERROR "Consumer publication must not overlap the OpenSSL driver or source directories")
    endif()
endforeach()
get_filename_component(publish_root "${DESTINATION}" DIRECTORY)
get_filename_component(stage_name "${DESTINATION}" NAME)
get_filename_component(publish_config "${publish_root}" NAME)
if(NOT publish_config STREQUAL OSSL_CONFIG)
    message(FATAL_ERROR "Consumer publication configuration must match its OpenSSL driver input")
endif()
if(NOT stage_name STREQUAL "stage" OR IS_SYMLINK "${publish_root}" OR IS_SYMLINK "${DESTINATION}")
    message(FATAL_ERROR "Use a dedicated non-symlink consumer stage directory")
endif()
file(LOCK "${OSSL_ROOT}/build.lock" GUARD PROCESS TIMEOUT 600 RESULT_VARIABLE lock_result)
if(NOT lock_result STREQUAL "0")
    message(FATAL_ERROR "Cannot lock OpenSSL publication input: ${lock_result}")
endif()
file(MAKE_DIRECTORY "${publish_root}")
file(REMOVE "${publish_root}/ready")
ossl_stage_valid(valid)
if(NOT valid OR EXISTS "${OSSL_ROOT}/failed")
    message(FATAL_ERROR "OpenSSL driver stage is not ready for publication; run the driver first")
endif()
file(READ "${OSSL_ROOT}/stage-manifest.sha256" expected_inventory)
set(expected_files)
string(REPLACE "\n" ";" records "${expected_inventory}")
foreach(record IN LISTS records)
    if(record STREQUAL "")
        continue()
    endif()
    if(NOT record MATCHES "^([0-9a-f]+)  (.+)$")
        message(FATAL_ERROR "Malformed OpenSSL driver stage manifest")
    endif()
    set(relative "${CMAKE_MATCH_2}")
    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|[/\\\\])\\.\\.([/\\\\]|$)")
        message(FATAL_ERROR "Unsafe path in OpenSSL driver stage manifest")
    endif()
    list(APPEND expected_files "${relative}")
endforeach()
if(EXISTS "${DESTINATION}")
    # Inventory rejects symlinks. Unexpected files are never deleted or folded
    # into this immutable identity; choose a new consumer build directory.
    ossl_inventory("${DESTINATION}" previous_hash previous_inventory)
    string(REPLACE "\n" ";" previous_records "${previous_inventory}")
    foreach(record IN LISTS previous_records)
        if(record MATCHES "^[0-9a-f]+  (.+)$" AND NOT CMAKE_MATCH_1 IN_LIST expected_files)
            message(FATAL_ERROR "Unexpected consumer stage file: ${CMAKE_MATCH_1}; preserve it and use a fresh consumer build directory")
        endif()
    endforeach()
endif()
foreach(relative IN LISTS expected_files)
    get_filename_component(directory "${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${DESTINATION}/${directory}")
    file(COPY_FILE "${OSSL_STAGE}/${relative}" "${DESTINATION}/${relative}" ONLY_IF_DIFFERENT RESULT copy_result)
    if(NOT copy_result STREQUAL "0")
        message(FATAL_ERROR "Cannot publish OpenSSL ${relative}: ${copy_result}")
    endif()
endforeach()
ossl_inventory("${DESTINATION}" published_hash published_inventory)
if(NOT published_inventory STREQUAL expected_inventory)
    message(FATAL_ERROR "Published OpenSSL consumer stage does not match the verified driver manifest")
endif()
ossl_write_if_changed("${publish_root}/stage-manifest.sha256" "${published_inventory}")
ossl_write_if_changed("${publish_root}/input-info.txt" "input=${INPUT}\nidentity=${OSSL_ID}\ndriver_stage=${OSSL_STAGE}\nconsumer_stage=${DESTINATION}\n")
file(WRITE "${publish_root}/ready.tmp" "${OSSL_ID}\n${published_hash}\n")
file(RENAME "${publish_root}/ready.tmp" "${publish_root}/ready")
message(STATUS "OpenSSL ${OSSL_CONFIG} consumer stage verified: ${DESTINATION}")
