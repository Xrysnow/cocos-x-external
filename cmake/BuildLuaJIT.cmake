# Build the official v2.1 submodule without writing into its worktree.
set(lj_source "${CMAKE_CURRENT_LIST_DIR}/../LuaJIT")
get_filename_component(lj_source "${lj_source}" ABSOLUTE)
set(lj_scripts "${CMAKE_CURRENT_LIST_DIR}")
if(NOT EXISTS "${lj_source}/src/Makefile")
    message(FATAL_ERROR "Initialize external/LuaJIT (official LuaJIT v2.1 submodule).")
endif()
set(CC_LUAJIT_JOBS 4 CACHE STRING "Parallel jobs in the LuaJIT GNU make build")
if(NOT CC_LUAJIT_JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "CC_LUAJIT_JOBS must be a positive integer")
endif()
if(CMAKE_CONFIGURATION_TYPES)
    set(lj_configs ${CMAKE_CONFIGURATION_TYPES})
else()
    set(lj_configs ${CMAKE_BUILD_TYPE})
endif()
if(NOT lj_configs)
    message(FATAL_ERROR "LuaJIT requires an explicit Debug or Release configuration")
endif()
foreach(lj_config IN LISTS lj_configs)
    if(NOT lj_config MATCHES "^(Debug|Release)$")
        message(FATAL_ERROR "LuaJIT wrapper supports Debug and Release; got ${lj_config}")
    endif()
endforeach()

# Exported source snapshots must resolve .relver, as git archive does.
file(READ "${lj_source}/.relver" lj_relver)
if(EXISTS "${lj_source}/.git")
    find_package(Git REQUIRED)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${lj_source}" show -s --format=%ct
        OUTPUT_VARIABLE lj_relver OUTPUT_STRIP_TRAILING_WHITESPACE
        COMMAND_ERROR_IS_FATAL ANY)
endif()
string(STRIP "${lj_relver}" lj_relver)
if(NOT lj_relver MATCHES "^[0-9]+$")
    message(FATAL_ERROR "LuaJIT snapshot needs a resolved .relver or its submodule Git metadata")
endif()

set(lj_environment)
set(lj_make_args)
if(WIN32)
    if(NOT MSVC)
        message(FATAL_ERROR "Native Windows LuaJIT currently requires MSVC")
    endif()
    set(lj_vs_root "${CMAKE_GENERATOR_INSTANCE}")
    if(NOT lj_vs_root)
        find_program(lj_vswhere vswhere PATHS "$ENV{ProgramFiles\(x86\)}/Microsoft Visual Studio/Installer")
        if(lj_vswhere)
            execute_process(COMMAND "${lj_vswhere}" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath
                OUTPUT_VARIABLE lj_vs_root OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        endif()
    endif()
    set(lj_vcvars "${lj_vs_root}/VC/Auxiliary/Build/vcvarsall.bat")
    if(NOT EXISTS "${lj_vcvars}")
        message(FATAL_ERROR "Cannot locate MSVC vcvarsall.bat")
    endif()
    if(CMAKE_GENERATOR_PLATFORM MATCHES "ARM64" OR CMAKE_SYSTEM_PROCESSOR MATCHES "^(ARM64|aarch64)$")
        set(lj_vcarch x64_arm64)
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(lj_vcarch x64)
    else()
        set(lj_vcarch x86)
    endif()
    add_library(luajit SHARED IMPORTED GLOBAL)
else()
    find_program(CC_LUAJIT_MAKE NAMES gmake make mingw32-make REQUIRED)
    set(lj_cc "\"${CMAKE_C_COMPILER}\"")
    if(CMAKE_C_COMPILER_TARGET)
        string(APPEND lj_cc " --target=${CMAKE_C_COMPILER_TARGET}")
    endif()
    if(CMAKE_SYSROOT)
        string(APPEND lj_cc " --sysroot=\"${CMAKE_SYSROOT}\"")
    endif()
    set(lj_target_flags "${CMAKE_C_FLAGS} -fPIC")
    if(ANDROID)
        if(NOT ANDROID_ABI MATCHES "^(arm64-v8a|x86_64)$")
            message(FATAL_ERROR "LuaJIT Android wrapper currently supports arm64-v8a and x86_64")
        endif()
        list(APPEND lj_make_args TARGET_SYS=Linux)
    elseif(APPLE)
        list(LENGTH CMAKE_OSX_ARCHITECTURES lj_arch_count)
        if(NOT lj_arch_count EQUAL 1 OR NOT CMAKE_OSX_DEPLOYMENT_TARGET)
            message(FATAL_ERROR "LuaJIT Apple builds require one CMAKE_OSX_ARCHITECTURES and a deployment target")
        endif()
        if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
            message(FATAL_ERROR "LuaJIT Apple builds require a native macOS host")
        endif()
        execute_process(COMMAND xcrun --sdk "${CMAKE_OSX_SYSROOT}" --show-sdk-path
            OUTPUT_VARIABLE lj_sdk OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        string(APPEND lj_target_flags " -arch ${CMAKE_OSX_ARCHITECTURES} -isysroot \"${lj_sdk}\"")
        if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
            string(APPEND lj_target_flags " -mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
            list(APPEND lj_environment "MACOSX_DEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET}")
            list(APPEND lj_make_args TARGET_SYS=Darwin)
        elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
            get_filename_component(lj_sdk_name "${lj_sdk}" NAME)
            string(TOLOWER "${lj_sdk_name}" lj_sdk_name)
            set(lj_target "${CMAKE_OSX_ARCHITECTURES}-apple-ios${CMAKE_OSX_DEPLOYMENT_TARGET}")
            if(lj_sdk_name MATCHES "^iphonesimulator[0-9.]*\\.sdk$")
                if(NOT CMAKE_OSX_ARCHITECTURES MATCHES "^(arm64|x86_64)$")
                    message(FATAL_ERROR "LuaJIT iOS simulator supports arm64 or x86_64")
                endif()
                string(APPEND lj_target "-simulator")
            elseif(lj_sdk_name MATCHES "^iphoneos[0-9.]*\\.sdk$")
                if(NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
                    message(FATAL_ERROR "LuaJIT iOS device builds require arm64")
                endif()
            else()
                message(FATAL_ERROR "LuaJIT iOS requires the iphoneos or iphonesimulator SDK")
            endif()
            string(APPEND lj_target_flags " -target ${lj_target}")
            # Upstream's iOS mode disables JIT in both the target and buildvm.
            list(APPEND lj_make_args TARGET_SYS=iOS)
            # Xcode exports the target SDK to build phases. Host generators
            # must still compile and run on macOS, including simulator builds.
            execute_process(COMMAND xcrun --sdk macosx --show-sdk-path
                OUTPUT_VARIABLE lj_host_sdk OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
            list(APPEND lj_make_args "HOST_CFLAGS=-isysroot \"${lj_host_sdk}\""
                "HOST_LDFLAGS=-isysroot \"${lj_host_sdk}\"")
            list(APPEND lj_environment "SDKROOT=${lj_host_sdk}"
                "MACOSX_DEPLOYMENT_TARGET=" "IPHONEOS_DEPLOYMENT_TARGET=")
        else()
            message(FATAL_ERROR "Unsupported LuaJIT Apple platform: ${CMAKE_SYSTEM_NAME}")
        endif()
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        list(APPEND lj_make_args TARGET_SYS=Linux)
    else()
        message(FATAL_ERROR "Unsupported LuaJIT platform: ${CMAKE_SYSTEM_NAME}")
    endif()
    if(CMAKE_HOST_WIN32)
        # NDK cannot build host generators. Use existing MinGW and MSYS tools.
        find_program(CC_LUAJIT_HOST_CC NAMES gcc REQUIRED)
        find_path(CC_LUAJIT_MSYS_ROOT usr/bin/sh.exe REQUIRED)
        get_filename_component(lj_host_bin "${CC_LUAJIT_HOST_CC}" DIRECTORY)
        set(lj_path "${CC_LUAJIT_MSYS_ROOT}/usr/bin;${lj_host_bin};$ENV{PATH}")
        string(REPLACE ";" "\\;" lj_path "${lj_path}")
        list(APPEND lj_environment "PATH=${lj_path}" MSYS2_ARG_CONV_EXCL=*)
        list(APPEND lj_make_args HOST_SYS=Windows HOST_MSYS=mingw
            "SHELL=${CC_LUAJIT_MSYS_ROOT}/usr/bin/sh.exe")
    else()
        find_program(CC_LUAJIT_HOST_CC NAMES cc clang gcc NO_CMAKE_FIND_ROOT_PATH REQUIRED)
    endif()
    list(APPEND lj_make_args "HOST_CC=\"${CC_LUAJIT_HOST_CC}\""
        "STATIC_CC=${lj_cc}" "TARGET_LD=${lj_cc}"
        "TARGET_AR=\"${CMAKE_AR}\" rcus" "TARGET_STRIP=\"${CMAKE_STRIP}\""
        "TARGET_CFLAGS=${lj_target_flags}" "TARGET_LDFLAGS=${lj_target_flags} ${CMAKE_EXE_LINKER_FLAGS}"
        BUILDMODE=static)
    add_library(luajit STATIC IMPORTED GLOBAL)
    set_property(TARGET luajit PROPERTY INTERFACE_LINK_LIBRARIES "${CMAKE_DL_LIBS};m")
endif()

# Inputs/options get separate directories to prevent incompatible object reuse.
# Old outputs remain available; the upstream worktree is never cleaned.
file(GLOB_RECURSE lj_inputs CONFIGURE_DEPENDS "${lj_source}/src/*" "${lj_source}/dynasm/*")
list(APPEND lj_inputs "${lj_source}/.relver" "${CMAKE_CURRENT_LIST_FILE}"
    "${lj_scripts}/RunLuaJIT.cmake" "${lj_scripts}/LuaJITConfig.cmake.in")
set(lj_identity "${lj_relver};${lj_make_args};${lj_environment};${lj_vcvars};${lj_vcarch};${CMAKE_C_COMPILER_VERSION}")
foreach(lj_input IN LISTS lj_inputs)
    file(SHA256 "${lj_input}" lj_hash)
    string(APPEND lj_identity "${lj_hash}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${lj_inputs})
string(SHA256 lj_identity "${lj_identity}")
string(SUBSTRING "${lj_identity}" 0 16 lj_identity)
set(lj_root "${CMAKE_CURRENT_BINARY_DIR}/luajit/${lj_identity}")
configure_file("${lj_scripts}/LuaJITConfig.cmake.in" "${CMAKE_CURRENT_BINARY_DIR}/luajit-config.cmake" @ONLY)
set(lj_byproducts)
foreach(lj_config IN LISTS lj_configs)
    string(TOUPPER "${lj_config}" lj_upper)
    set(lj_output "${lj_root}/${lj_config}/src")
    file(MAKE_DIRECTORY "${lj_output}")
    set_property(TARGET luajit APPEND PROPERTY IMPORTED_CONFIGURATIONS "${lj_config}")
    if(WIN32)
        set_target_properties(luajit PROPERTIES
            "IMPORTED_LOCATION_${lj_upper}" "${lj_output}/lua51.dll"
            "IMPORTED_IMPLIB_${lj_upper}" "${lj_output}/lua51.lib")
        list(APPEND lj_byproducts "$<$<CONFIG:${lj_config}>:${lj_output}/lua51.dll>" "$<$<CONFIG:${lj_config}>:${lj_output}/lua51.lib>")
    else()
        set_property(TARGET luajit PROPERTY "IMPORTED_LOCATION_${lj_upper}" "${lj_output}/libluajit.a")
        list(APPEND lj_byproducts "$<$<CONFIG:${lj_config}>:${lj_output}/libluajit.a>")
    endif()
    target_include_directories(luajit INTERFACE "$<$<CONFIG:${lj_config}>:${lj_output}>")
endforeach()
target_include_directories(luajit INTERFACE "${lj_source}/src")
target_compile_definitions(luajit INTERFACE USING_LUAJIT=1)
add_custom_target(cc_luajit_build
    COMMAND "${CMAKE_COMMAND}" "-DCONFIG=$<CONFIG>" "-DSETTINGS=${CMAKE_CURRENT_BINARY_DIR}/luajit-config.cmake"
        -P "${lj_scripts}/RunLuaJIT.cmake"
    BYPRODUCTS ${lj_byproducts}
    COMMENT "Building official LuaJIT v2.1 ($<CONFIG>)" VERBATIM)
add_dependencies(luajit cc_luajit_build)
