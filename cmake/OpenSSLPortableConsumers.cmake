include_guard(GLOBAL)

# Prepare explicitly requested Debug/Release stages before curl/libzip probes.
# Xcode and Ninja Multi-Config use configuration-specific imports and headers.
include("${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/OpenSSLPortableTargets.cmake")
ossl_portable_configurations(configurations)
list(GET configurations 0 default_probe_configuration)
set(CMAKE_TRY_COMPILE_CONFIGURATION "${default_probe_configuration}" CACHE STRING "Prepared OpenSSL configuration used for dependency link probes")
if(NOT CMAKE_TRY_COMPILE_CONFIGURATION IN_LIST configurations)
    message(FATAL_ERROR "CMAKE_TRY_COMPILE_CONFIGURATION must name a prepared OpenSSL configuration: ${configurations}")
endif()
if(CC_OPENSSL_CONSUMER_ID)
    set(previous_consumer_id "${CC_OPENSSL_CONSUMER_ID}")
else()
    foreach(old OPENSSL_ROOT_DIR OPENSSL_INCLUDE_DIR OPENSSL_CRYPTO_LIBRARY OPENSSL_SSL_LIBRARY)
        if(${old})
            message(FATAL_ERROR "Use a new build directory or cmake --fresh when replacing an older OpenSSL consumer selection")
        endif()
    endforeach()
endif()
# Bundled input and fixed feature settings are shared with standalone drivers.
include("${CMAKE_CURRENT_LIST_DIR}/BuildOpenSSL.cmake")
cc_build_openssl()
set(consumer_identity "static\nprobe=${CMAKE_TRY_COMPILE_CONFIGURATION}\n")
foreach(name IN LISTS configurations)
    string(TOUPPER "${name}" upper)
    include("${CC_OPENSSL_${upper}_INPUT}")
    string(APPEND consumer_identity "${name}=${OSSL_ID}\n")
    string(TOLOWER "${name}" lower)
    set(driver_${lower}_stage "${CC_OPENSSL_${upper}_STAGE}")
endforeach()
string(SHA256 consumer_id "${consumer_identity}")
if(previous_consumer_id AND NOT previous_consumer_id STREQUAL consumer_id)
    message(FATAL_ERROR "OpenSSL identity changed. Use cmake --fresh with the same explicit inputs so all consumer probes run again")
endif()
set(CC_OPENSSL_CONSUMER_ID "${consumer_id}" CACHE INTERNAL "OpenSSL identity used for consumer configuration" FORCE)
set(publisher "${CMAKE_CURRENT_LIST_DIR}/PublishOpenSSL.cmake")
set(byproducts)
set(selected_stage "")
set(selected_input "")
set(stages_json "{\n")
foreach(name IN LISTS configurations)
    string(TOUPPER "${name}" upper)
    string(TOLOWER "${name}" lower)
    set(destination "${CMAKE_BINARY_DIR}/openssl-consumers/${consumer_id}/${name}/stage")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${CC_OPENSSL_${upper}_INPUT}" "-DDESTINATION=${destination}"
        -P "${publisher}" RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Cannot publish portable OpenSSL ${name} consumer artifacts")
    endif()
    set(CC_OPENSSL_${upper}_STAGE "${destination}")
    file(STRINGS "${destination}/../stage-manifest.sha256" records)
    foreach(record IN LISTS records)
        if(record MATCHES "^[0-9a-f]+  (.+)$")
            if(CMAKE_CONFIGURATION_TYPES)
                list(APPEND byproducts "$<$<CONFIG:${name}>:${destination}/${CMAKE_MATCH_1}>")
            else()
                list(APPEND byproducts "${destination}/${CMAKE_MATCH_1}")
            endif()
        endif()
    endforeach()
    if(CMAKE_CONFIGURATION_TYPES)
        string(APPEND selected_stage "$<$<CONFIG:${name}>:${destination}>")
        string(APPEND selected_input "$<$<CONFIG:${name}>:${CC_OPENSSL_${upper}_INPUT}>")
    else()
        set(selected_stage "${destination}")
        set(selected_input "${CC_OPENSSL_${upper}_INPUT}")
    endif()
    string(APPEND stages_json "  \"${name}\": \"${destination}\",\n  \"${name}Input\": \"${CC_OPENSSL_${upper}_INPUT}\",\n  \"Driver${name}\": \"${driver_${lower}_stage}\",\n")
endforeach()
add_custom_target(cc_openssl_publish COMMAND "${CMAKE_COMMAND}" "-DINPUT=${selected_input}"
    "-DDESTINATION=${selected_stage}" -P "${publisher}" BYPRODUCTS ${byproducts} VERBATIM)
add_dependencies(cc_openssl_publish cc_openssl_build)
foreach(component Crypto SSL)
    string(TOLOWER "${component}" library)
    set_target_properties(OpenSSL::${component} PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${selected_stage}/include")
    foreach(name IN LISTS configurations)
        string(TOUPPER "${name}" upper)
        set_target_properties(OpenSSL::${component} PROPERTIES
            IMPORTED_LOCATION_${upper} "${CC_OPENSSL_${upper}_STAGE}/lib/lib${library}.a")
    endforeach()
    if(NOT CMAKE_CONFIGURATION_TYPES)
        set_property(TARGET OpenSSL::${component} PROPERTY IMPORTED_LOCATION "${selected_stage}/lib/lib${library}.a")
    endif()
    add_dependencies(OpenSSL::${component} cc_openssl_publish)
endforeach()
string(TOUPPER "${CMAKE_TRY_COMPILE_CONFIGURATION}" probe_config)
set(probe_stage "${CC_OPENSSL_${probe_config}_STAGE}")
set(OPENSSL_ROOT_DIR "${probe_stage}" CACHE PATH "Selected portable OpenSSL probe installation" FORCE)
set(OPENSSL_INCLUDE_DIR "${probe_stage}/include" CACHE PATH "Selected portable OpenSSL probe headers" FORCE)
set(OPENSSL_CRYPTO_LIBRARY "${probe_stage}/lib/libcrypto.a" CACHE FILEPATH "Selected portable OpenSSL Crypto probe library" FORCE)
set(OPENSSL_SSL_LIBRARY "${probe_stage}/lib/libssl.a" CACHE FILEPATH "Selected portable OpenSSL SSL probe library" FORCE)
set(OPENSSL_USE_STATIC_LIBS ON CACHE BOOL "Portable OpenSSL uses static libraries" FORCE)
ossl_source_version(OSSL_SOURCE_VERSION)
set(OPENSSL_VERSION "${OSSL_SOURCE_VERSION}" CACHE INTERNAL "Selected OpenSSL version" FORCE)
set(CC_OPENSSL_STAGE "${selected_stage}")
set(CC_OPENSSL_INPUT "${selected_input}")
file(WRITE "${CMAKE_BINARY_DIR}/openssl-stages.json"
    "${stages_json}  \"ConsumerId\": \"${consumer_id}\",\n  \"ProbeConfiguration\": \"${CMAKE_TRY_COMPILE_CONFIGURATION}\",\n  \"Target\": \"${OSSL_TARGET}\",\n  \"Linkage\": \"static, default and legacy built-in\",\n  \"RuntimeOpenSSLDir\": \"${OSSL_RUNTIME_OPENSSLDIR}\"\n}\n")
ossl_add_configure_dependencies("${CMAKE_CURRENT_LIST_FILE}" "${publisher}")
message(STATUS "OpenSSL consumers: ${OSSL_SOURCE_VERSION} static; target=${OSSL_TARGET}; profile=peripheral; configurations=${configurations}; probe=${CMAKE_TRY_COMPILE_CONFIGURATION}; identity=${consumer_id}")
