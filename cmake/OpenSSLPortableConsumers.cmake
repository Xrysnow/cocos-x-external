include_guard(GLOBAL)

# A native POSIX, single-configuration static installation is prepared before
# curl/libzip perform their configure-time OpenSSL link probes.
if(CC_OPENSSL_CONSUMER_ID)
    set(previous_consumer_id "${CC_OPENSSL_CONSUMER_ID}")
else()
    foreach(old OPENSSL_ROOT_DIR OPENSSL_INCLUDE_DIR OPENSSL_CRYPTO_LIBRARY OPENSSL_SSL_LIBRARY)
        if(${old})
            message(FATAL_ERROR "Use a new build directory or cmake --fresh when replacing an older OpenSSL consumer selection")
        endif()
    endforeach()
endif()
set(CC_OPENSSL_SOURCE_DIR "" CACHE PATH "Local fixed OpenSSL 3.5.9 source snapshot")
set(CC_OPENSSL_ARCHIVE "" CACHE FILEPATH "Optional local fixed OpenSSL archive")
set(CC_OPENSSL_SOURCE_LAYOUT "full" CACHE STRING "OpenSSL source layout: full or pruned")
set(CC_OPENSSL_PROFILE "peripheral" CACHE STRING "OpenSSL feature profile")
if(NOT CC_OPENSSL_SOURCE_DIR)
    if(NOT EXISTS "${CC_OPENSSL_ARCHIVE}")
        message(FATAL_ERROR "Set CC_OPENSSL_SOURCE_DIR or CC_OPENSSL_ARCHIVE to the pinned local input; no download is performed")
    endif()
    set(prepared "${CMAKE_BINARY_DIR}/openssl-inputs/full")
    if(NOT EXISTS "${prepared}/openssl-3.5.9/Configure")
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DARCHIVE=${CC_OPENSSL_ARCHIVE}" "-DDESTINATION=${prepared}"
            -P "${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/PrepareSource.cmake" RESULT_VARIABLE rc)
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "Cannot prepare the fixed complete OpenSSL snapshot")
        endif()
    endif()
    if(CC_OPENSSL_SOURCE_LAYOUT STREQUAL "pruned")
        set(pruned "${CMAKE_BINARY_DIR}/openssl-inputs/pruned")
        if(NOT EXISTS "${pruned}/openssl-3.5.9/Configure")
            execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${prepared}/openssl-3.5.9" "-DDESTINATION=${pruned}"
                -P "${CMAKE_CURRENT_LIST_DIR}/../openssl/cmake/PreparePrunedSource.cmake" RESULT_VARIABLE rc)
            if(NOT rc EQUAL 0)
                message(FATAL_ERROR "Cannot prepare the fixed pruned OpenSSL snapshot")
            endif()
        endif()
        set(prepared "${pruned}")
    endif()
    set(CC_OPENSSL_SOURCE_DIR "${prepared}/openssl-3.5.9" CACHE PATH "Local fixed OpenSSL source snapshot" FORCE)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/BuildOpenSSL.cmake")
cc_build_openssl()
include("${CC_OPENSSL_INPUT}")
string(SHA256 consumer_id "${OSSL_ID}\n${CC_OPENSSL_CONFIGURATION}\nstatic")
if(previous_consumer_id AND NOT previous_consumer_id STREQUAL consumer_id)
    message(FATAL_ERROR "OpenSSL identity changed. Use cmake --fresh with the same explicit inputs so all consumer probes run again")
endif()
set(CC_OPENSSL_CONSUMER_ID "${consumer_id}" CACHE INTERNAL "OpenSSL identity used for consumer configuration" FORCE)
set(driver_stage "${CC_OPENSSL_STAGE}")
set(destination "${CMAKE_BINARY_DIR}/openssl-consumers/${consumer_id}/${CC_OPENSSL_CONFIGURATION}/stage")
set(publisher "${CMAKE_CURRENT_LIST_DIR}/PublishOpenSSL.cmake")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${CC_OPENSSL_INPUT}" "-DDESTINATION=${destination}"
    -P "${publisher}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Cannot publish portable OpenSSL consumer artifacts")
endif()
file(STRINGS "${destination}/../stage-manifest.sha256" records)
set(byproducts)
foreach(record IN LISTS records)
    if(record MATCHES "^[0-9a-f]+  (.+)$")
        list(APPEND byproducts "${destination}/${CMAKE_MATCH_1}")
    endif()
endforeach()
add_custom_target(cc_openssl_publish COMMAND "${CMAKE_COMMAND}" "-DINPUT=${CC_OPENSSL_INPUT}"
    "-DDESTINATION=${destination}" -P "${publisher}" BYPRODUCTS ${byproducts} VERBATIM)
add_dependencies(cc_openssl_publish cc_openssl_build)
foreach(component Crypto SSL)
    string(TOLOWER "${component}" library)
    set_target_properties(OpenSSL::${component} PROPERTIES IMPORTED_LOCATION "${destination}/lib/lib${library}.a"
        INTERFACE_INCLUDE_DIRECTORIES "${destination}/include")
    add_dependencies(OpenSSL::${component} cc_openssl_publish)
endforeach()
set(OPENSSL_ROOT_DIR "${destination}" CACHE PATH "Selected portable OpenSSL installation" FORCE)
set(OPENSSL_INCLUDE_DIR "${destination}/include" CACHE PATH "Selected portable OpenSSL headers" FORCE)
set(OPENSSL_CRYPTO_LIBRARY "${destination}/lib/libcrypto.a" CACHE FILEPATH "Selected portable OpenSSL Crypto library" FORCE)
set(OPENSSL_SSL_LIBRARY "${destination}/lib/libssl.a" CACHE FILEPATH "Selected portable OpenSSL SSL library" FORCE)
set(OPENSSL_USE_STATIC_LIBS ON CACHE BOOL "Android/macOS OpenSSL uses static libraries" FORCE)
set(OPENSSL_VERSION "3.5.9" CACHE INTERNAL "Selected OpenSSL version" FORCE)
set(CC_OPENSSL_STAGE "${destination}")
file(WRITE "${CMAKE_BINARY_DIR}/openssl-stages.json"
    "{\n  \"${CC_OPENSSL_CONFIGURATION}\": \"${destination}\",\n  \"${CC_OPENSSL_CONFIGURATION}Input\": \"${CC_OPENSSL_INPUT}\",\n  \"Driver${CC_OPENSSL_CONFIGURATION}\": \"${driver_stage}\",\n  \"ConsumerId\": \"${consumer_id}\",\n  \"Target\": \"${OSSL_TARGET}\",\n  \"Linkage\": \"static, default and legacy built-in\",\n  \"RuntimeOpenSSLDir\": \"${OSSL_RUNTIME_OPENSSLDIR}\"\n}\n")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_FILE}" "${publisher}")
message(STATUS "OpenSSL consumers: 3.5.9 static; target=${OSSL_TARGET}; profile=${CC_OPENSSL_PROFILE}; identity=${consumer_id}")
