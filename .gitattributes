# Auto detect text files and perform LF normalization
* text=auto

# Preserve the pinned upstream OpenSSL snapshot byte-for-byte on every host.
openssl/src/** -text -filter -ident -working-tree-encoding
openssl/source-executables.txt -text -filter -ident -working-tree-encoding

# Preserve the pinned upstream zlib sources byte-for-byte on every host.
zlib/src/** -text -filter -ident -working-tree-encoding
