include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLSource.cmake")

# Reconstruct the exact pinned snapshot in the build tree without modifying the
# vendored input. Existing bytes and paths are verified, never overwritten.
function(ossl_prepare_bundled_source source destination)
    foreach(path "${source}" "${destination}")
        ossl_safe_value("${path}")
        if(NOT IS_ABSOLUTE "${path}")
            message(FATAL_ERROR "Bundled OpenSSL SOURCE and DESTINATION must be absolute local paths")
        endif()
    endforeach()
    ossl_resolve_path("${source}" source)
    ossl_resolve_path("${destination}" destination)
    cmake_path(IS_PREFIX source "${destination}" NORMALIZE nested)
    cmake_path(IS_PREFIX destination "${source}" NORMALIZE contains_source)
    if(nested OR contains_source)
        message(FATAL_ERROR "Bundled OpenSSL snapshot destination must not overlap its input")
    endif()
    # Always validate the actual vendored tree, even when output already exists.
    ossl_validate_bundled_source("${source}" hash inventory)
    set(identity "bundled_source=${source}\nsource=${hash}\nlayout=pruned\n")
    get_filename_component(parent "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(LOCK "${destination}.lock" GUARD FUNCTION TIMEOUT 60 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
        message(FATAL_ERROR "Cannot lock bundled OpenSSL snapshot ${destination}: ${lock_result}")
    endif()
    ossl_source_version(OSSL_SOURCE_VERSION)
    set(snapshot "${destination}/openssl-${OSSL_SOURCE_VERSION}")
    ossl_resolve_path("${snapshot}" resolved_snapshot)
    cmake_path(IS_PREFIX destination "${resolved_snapshot}" NORMALIZE inside_destination)
    if(IS_SYMLINK "${snapshot}" OR NOT inside_destination)
        message(FATAL_ERROR "Bundled snapshot root must be a private directory inside its destination: ${snapshot}")
    endif()
    set(existing FALSE)
    if(EXISTS "${destination}")
        if(NOT EXISTS "${destination}/source-identity.txt")
            message(FATAL_ERROR "Refusing to overwrite an existing or incomplete bundled snapshot: ${destination}")
        endif()
        file(READ "${destination}/source-identity.txt" existing_identity)
        if(NOT existing_identity STREQUAL identity)
            message(FATAL_ERROR "Bundled snapshot identity differs; use a fresh build directory: ${destination}")
        endif()
        if(NOT EXISTS "${destination}/source-files.sha256")
            message(FATAL_ERROR "Bundled snapshot inventory record is missing; use a fresh build directory: ${destination}")
        endif()
        file(READ "${destination}/source-files.sha256" existing_inventory)
        if(NOT existing_inventory STREQUAL inventory)
            message(FATAL_ERROR "Bundled snapshot inventory record changed; use a fresh build directory: ${destination}")
        endif()
        set(existing TRUE)
    else()
        file(MAKE_DIRECTORY "${snapshot}")
        file(COPY "${source}/" DESTINATION "${snapshot}")
        file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../prune-manifest.json" prune)
        string(JSON count LENGTH "${prune}" retained_empty_directories)
        if(count GREATER 0)
            math(EXPR last "${count}-1")
            foreach(index RANGE 0 ${last})
                string(JSON relative GET "${prune}" retained_empty_directories ${index})
                file(MAKE_DIRECTORY "${snapshot}/${relative}")
            endforeach()
        endif()
    endif()
    ossl_validate_source("${snapshot}" pruned peripheral OFF OFF prepared_hash prepared_inventory)
    if(NOT prepared_hash STREQUAL hash OR NOT prepared_inventory STREQUAL inventory)
        message(FATAL_ERROR "Bundled OpenSSL input changed during snapshot preparation")
    endif()
    # Only change modes after all bytes, directories and existing metadata pass.
    # The input tree is never chmod'ed, even when Git recorded its files as 644.
    ossl_bundled_executables("${snapshot}" executables)
    foreach(relative IN LISTS executables)
        file(CHMOD "${snapshot}/${relative}" PERMISSIONS
            OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endforeach()
    if(NOT existing)
        file(WRITE "${destination}/source-files.sha256" "${inventory}")
        file(WRITE "${destination}/source-identity.txt" "${identity}")
    endif()
    message(STATUS "Bundled unmodified pruned source: ${snapshot} (${hash})")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    cmake_minimum_required(VERSION 3.28)
    if(NOT DEFINED SOURCE OR NOT DEFINED DESTINATION)
        message(FATAL_ERROR "Pass -DSOURCE=<absolute bundled src> -DDESTINATION=<absolute build snapshot directory>")
    endif()
    ossl_prepare_bundled_source("${SOURCE}" "${DESTINATION}")
endif()
