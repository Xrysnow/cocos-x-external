include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLCommon.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLPortableTargets.cmake")

function(ossl_msys_path path out)
    file(TO_CMAKE_PATH "${path}" path)
    if(path MATCHES "^([A-Za-z]):/(.*)$")
        string(TOLOWER "${CMAKE_MATCH_1}" drive)
        set(path "/${drive}/${CMAKE_MATCH_2}")
    elseif(NOT path MATCHES "^/")
        message(FATAL_ERROR "MSYS requires an absolute local path: ${path}")
    endif()
    set(${out} "${path}" PARENT_SCOPE)
endfunction()

function(ossl_sh_quote value out)
    string(REPLACE "'" "'\\''" value "${value}")
    set(${out} "'${value}'" PARENT_SCOPE)
endfunction()

# Explicit MSYS Perl + native GNU make route. No tools/modules are installed or
# patched here: incomplete Git Perl may use an explicitly supplied .pm overlay.
macro(ossl_windows_android_tools)
    if(NOT CC_OPENSSL_ANDROID_WINDOWS_HOST OR NOT CMAKE_SYSTEM_NAME STREQUAL "Android")
        message(FATAL_ERROR "Windows Android OpenSSL requires explicit CC_OPENSSL_ANDROID_WINDOWS_HOST=ON, MSYS tools and a matching Windows NDK; WSL is not invoked")
    endif()
    ossl_portable_configurations(configurations)
    ossl_portable_target(mapping)
    set(CC_OPENSSL_MSYS_ROOT "" CACHE PATH "Existing MSYS root containing usr/bin/bash, sh and Perl")
    set(CC_OPENSSL_PERL5LIB "" CACHE PATH "Optional explicit pure Perl module overlay for MSYS Perl")
    set(CC_OPENSSL_MAKE "" CACHE FILEPATH "Explicit native Windows GNU make executable")
    set(CC_OPENSSL_JOBS "8" CACHE STRING "Maximum OpenSSL compile jobs (1 through 8)")
    set(CC_OPENSSL_RUNTIME_OPENSSLDIR "/usr/local/ssl" CACHE PATH "Target runtime certificate directory")
    if(NOT CC_OPENSSL_JOBS MATCHES "^[1-8]$" OR NOT CC_OPENSSL_RUNTIME_OPENSSLDIR MATCHES "^/"
       OR CC_OPENSSL_RUNTIME_OPENSSLDIR MATCHES "[;\r\n]")
        message(FATAL_ERROR "Invalid Windows Android OpenSSL jobs/runtime directory")
    endif()
    foreach(path "${CC_OPENSSL_MSYS_ROOT}" "${CC_OPENSSL_MAKE}")
        ossl_safe_value("${path}")
        if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}")
            message(FATAL_ERROR "Set explicit existing CC_OPENSSL_MSYS_ROOT and CC_OPENSSL_MAKE")
        endif()
    endforeach()
    set(msys "${CC_OPENSSL_MSYS_ROOT}")
    set(tools "${CC_OPENSSL_MAKE}")
    foreach(name bash.exe sh.exe perl.exe msys-2.0.dll)
        if(NOT EXISTS "${msys}/usr/bin/${name}")
            message(FATAL_ERROR "Incomplete MSYS runtime: ${msys}/usr/bin/${name}")
        endif()
        list(APPEND tools "${msys}/usr/bin/${name}")
    endforeach()
    set(overlay "")
    set(module_hash "none")
    if(CC_OPENSSL_PERL5LIB)
        ossl_safe_value("${CC_OPENSSL_PERL5LIB}")
        if(NOT IS_ABSOLUTE "${CC_OPENSSL_PERL5LIB}" OR NOT IS_DIRECTORY "${CC_OPENSSL_PERL5LIB}")
            message(FATAL_ERROR "CC_OPENSSL_PERL5LIB must be an existing absolute directory")
        endif()
        file(GLOB_RECURSE modules CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE "${CC_OPENSSL_PERL5LIB}/*")
        foreach(module IN LISTS modules)
            if(NOT module MATCHES "\\.pm$" OR IS_SYMLINK "${module}")
                message(FATAL_ERROR "MSYS module overlay accepts only plain .pm files: ${module}")
            endif()
        endforeach()
        list(APPEND tools ${modules})
        ossl_inventory("${CC_OPENSSL_PERL5LIB}" module_hash unused_modules)
        ossl_msys_path("${CC_OPENSSL_PERL5LIB}" overlay)
    endif()
    execute_process(COMMAND "${CC_OPENSSL_MAKE}" --version RESULT_VARIABLE rc OUTPUT_VARIABLE make_version)
    if(NOT rc EQUAL 0 OR NOT make_version MATCHES "GNU Make")
        message(FATAL_ERROR "CC_OPENSSL_MAKE must be GNU make")
    endif()
    set(ndk "${CMAKE_ANDROID_NDK}")
    if(NOT ndk)
        set(ndk "${ANDROID_NDK}")
    endif()
    ossl_safe_value("${ndk}")
    if(NOT IS_ABSOLUTE "${ndk}" OR NOT EXISTS "${ndk}/source.properties")
        message(FATAL_ERROR "Use the Windows NDK selected by the parent Android toolchain")
    endif()
    ossl_android_api(api)
    set(target "${mapping_TARGET}")
    set(triple "${mapping_TRIPLE}")
    set(ndk_bin "${ndk}/toolchains/llvm/prebuilt/windows-x86_64/bin")
    foreach(name clang.exe llvm-ar.exe llvm-ranlib.exe llvm-readelf.exe llvm-nm.exe
            "${triple}${api}-clang.cmd" "${triple}${api}-clang")
        if(NOT EXISTS "${ndk_bin}/${name}")
            message(FATAL_ERROR "Missing matching Windows NDK tool: ${ndk_bin}/${name}")
        endif()
        list(APPEND tools "${ndk_bin}/${name}")
    endforeach()
    list(APPEND tools "${ndk}/source.properties" "${ndk}/meta/platforms.json")
    find_program(windows_powershell NAMES powershell PATHS "$ENV{SystemRoot}/System32/WindowsPowerShell/v1.0"
        REQUIRED NO_CMAKE_FIND_ROOT_PATH)
    list(APPEND tools "${windows_powershell}")
    ossl_sh_quote("${overlay}" quoted_overlay)
    # Run all module checks under MSYS Perl, never Strawberry's native Perl.
    execute_process(COMMAND "${msys}/usr/bin/bash.exe" --noprofile --norc -c
        "export PERL5LIB=${quoted_overlay}; /usr/bin/perl -e 'use File::Spec; use IPC::Cmd; use Locale::Maketext::Simple; use JSON::PP; use Pod::Usage; use ExtUtils::MakeMaker; print qq($^O $^V\\n);'"
        RESULT_VARIABLE rc OUTPUT_VARIABLE perl_version ERROR_VARIABLE perl_error)
    if(NOT rc EQUAL 0 OR NOT perl_version MATCHES "^(msys|cygwin) v5\\.")
        message(FATAL_ERROR "MSYS Perl and its required modules are incomplete: ${perl_version}${perl_error}")
    endif()
    execute_process(COMMAND "${ndk_bin}/clang.exe" --version RESULT_VARIABLE rc OUTPUT_VARIABLE compiler_version)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Windows NDK clang cannot run")
    endif()
    file(READ "${ndk}/source.properties" ndk_version)
    set(records "")
    list(REMOVE_DUPLICATES tools)
    list(SORT tools)
    foreach(tool IN LISTS tools)
        ossl_safe_value("${tool}")
        file(SHA256 "${tool}" hash)
        string(APPEND records "${hash}  ${tool}\n")
    endforeach()
    set(identity "host=Windows/MSYS\nperl=${perl_version}\nmake=${make_version}\nNDK=${ndk}\n${ndk_version}\nclang=${compiler_version}\n${records}\nABI=${CMAKE_ANDROID_ARCH_ABI}\nAPI=${api}\nconfigurations=${configurations}\ncflags=${CMAKE_C_FLAGS}\ncompiler_arg1=${CMAKE_C_COMPILER_ARG1}\njobs=${CC_OPENSSL_JOBS}\nopenssldir=${CC_OPENSSL_RUNTIME_OPENSSLDIR}\noverlay_files=${module_hash}\n")
    string(SHA256 tool_hash "${identity}")
    ossl_msys_path("${CC_OPENSSL_MAKE}" msys_make)
    set(OSSL_PERL /usr/bin/perl)
    set(OSSL_MAKE "${msys_make}")
    set(OSSL_JOBS "${CC_OPENSSL_JOBS}")
    set(OSSL_TOOL_HASH "${tool_hash}")
    set(OSSL_TOOL_IDENTITY "${identity}")
    set(OSSL_TOOL_RECORDS "${records}")
    set(OSSL_TOOLS "${tools}")
    set(OSSL_TARGET "${target}")
    set(OSSL_TARGET_KEY "android-${CMAKE_ANDROID_ARCH_ABI}-api${api}")
    set(OSSL_PLATFORM_OPTIONS no-shared no-module "-D__ANDROID_API__=${api}")
    set(OSSL_COMPILER_FLAGS)
    foreach(flags "${CMAKE_C_COMPILER_ARG1}" "${CMAKE_C_FLAGS}")
        separate_arguments(arguments UNIX_COMMAND "${flags}")
        list(APPEND OSSL_COMPILER_FLAGS ${arguments})
    endforeach()
    set(OSSL_ENVIRONMENT LC_ALL=C LANG=C)
    set(OSSL_SYSTEM_LIBRARIES dl Threads::Threads)
    if(CMAKE_ANDROID_ARCH_ABI STREQUAL "x86")
        list(APPEND OSSL_SYSTEM_LIBRARIES atomic)
    endif()
    set(OSSL_ARCH "${mapping_ARCH}")
    set(OSSL_FORMAT "${mapping_FORMAT}")
    set(OSSL_ELF_CLASS "${mapping_ELF_CLASS}")
    set(OSSL_ELF_MACHINE "${mapping_ELF_MACHINE}")
    set(OSSL_NM_OPTIONS -g --defined-only)
    set(OSSL_READELF "${ndk_bin}/llvm-readelf.exe")
    set(OSSL_NM "${ndk_bin}/llvm-nm.exe")
    set(OSSL_LIPO "")
    set(OSSL_COMPILER "${ndk_bin}/${triple}${api}-clang.cmd")
    set(OSSL_RUNTIME_OPENSSLDIR "${CC_OPENSSL_RUNTIME_OPENSSLDIR}")
    set(OSSL_WINDOWS_ANDROID TRUE)
    set(OSSL_MSYS_ROOT "${msys}")
    set(OSSL_MSYS_PERL5LIB "${CC_OPENSSL_PERL5LIB}")
    set(OSSL_MSYS_MODULES_HASH "${module_hash}")
    set(OSSL_ANDROID_NDK "${ndk}")
    set(OSSL_POWERSHELL "${windows_powershell}")
endmacro()
