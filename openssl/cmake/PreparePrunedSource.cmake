cmake_minimum_required(VERSION 3.28)
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLSource.cmake")
foreach(name SOURCE DESTINATION)
    if(NOT DEFINED ${name} OR NOT IS_ABSOLUTE "${${name}}")
        message(FATAL_ERROR "Pass -D${name}=<absolute local path>")
    endif()
    ossl_safe_value("${${name}}")
endforeach()
if(EXISTS "${DESTINATION}")
    message(FATAL_ERROR "Refusing to overwrite existing snapshot: ${DESTINATION}")
endif()
ossl_resolve_path("${SOURCE}" SOURCE)
ossl_resolve_path("${DESTINATION}" DESTINATION)
cmake_path(IS_PREFIX SOURCE "${DESTINATION}" NORMALIZE nested)
cmake_path(IS_PREFIX DESTINATION "${SOURCE}" NORMALIZE contains_source)
if(nested OR contains_source)
    message(FATAL_ERROR "Pruned snapshot must not overlap the complete input")
endif()
ossl_validate_source("${SOURCE}" full peripheral OFF OFF full_hash inventory)
file(READ "${CMAKE_CURRENT_LIST_DIR}/../prune-manifest.json" manifest)
string(JSON count LENGTH "${manifest}" excluded_directories)
math(EXPR last "${count}-1")
set(exclusions)
foreach(index RANGE 0 ${last})
    string(JSON relative GET "${manifest}" excluded_directories ${index})
    list(APPEND exclusions "${relative}")
endforeach()
string(JSON count LENGTH "${manifest}" excluded_empty_directories)
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
    string(JSON relative GET "${manifest}" excluded_empty_directories ${index})
    list(APPEND exclusions "${relative}")
endforeach()
set(source "${DESTINATION}/openssl-3.5.9")
file(MAKE_DIRECTORY "${source}")
# Preserve every non-excluded directory, including fuzz/corpora and other
# empty directories; a file-only copy would silently expand the prune scope.
file(GLOB_RECURSE directories LIST_DIRECTORIES TRUE RELATIVE "${SOURCE}" "${SOURCE}/*" "${SOURCE}/.*")
foreach(relative IN LISTS directories)
    if(NOT IS_DIRECTORY "${SOURCE}/${relative}")
        continue()
    endif()
    set(skip FALSE)
    foreach(excluded IN LISTS exclusions)
        cmake_path(IS_PREFIX excluded "${relative}" NORMALIZE skip)
        if(skip)
            break()
        endif()
    endforeach()
    if(NOT skip)
        file(MAKE_DIRECTORY "${source}/${relative}")
    endif()
endforeach()
string(REPLACE "\n" ";" records "${inventory}")
foreach(record IN LISTS records)
    if(NOT record MATCHES "^[0-9a-f]+  (.+)$")
        continue()
    endif()
    set(relative "${CMAKE_MATCH_1}")
    set(skip FALSE)
    foreach(excluded IN LISTS exclusions)
        cmake_path(IS_PREFIX excluded "${relative}" NORMALIZE skip)
        if(skip)
            break()
        endif()
    endforeach()
    if(skip)
        continue()
    endif()
    get_filename_component(parent "${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${source}/${parent}")
    file(COPY_FILE "${SOURCE}/${relative}" "${source}/${relative}")
endforeach()
ossl_validate_source("${source}" pruned peripheral OFF OFF pruned_hash pruned_inventory)
file(WRITE "${DESTINATION}/source-files.sha256" "${pruned_inventory}")
file(WRITE "${DESTINATION}/source-identity.txt" "full_source=${full_hash}\nsource=${pruned_hash}\nlayout=pruned\n")
message(STATUS "Pruned unmodified source: ${source} (${pruned_hash})")
