include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLCommon.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/WindowsTargets.cmake")

function(ossl_windows_tools)
    if(NOT CC_OPENSSL_BACKEND MATCHES "^(nmake|jom)$")
        message(FATAL_ERROR "CC_OPENSSL_BACKEND must be nmake or jom")
    endif()
    if(NOT "${CC_OPENSSL_JOBS}" MATCHES "^[1-8]$")
        message(FATAL_ERROR "CC_OPENSSL_JOBS must be an integer from 1 through 8")
    endif()
    if(NOT CMAKE_HOST_WIN32 OR NOT WIN32 OR NOT CMAKE_SYSTEM_NAME STREQUAL "Windows"
        OR NOT MSVC OR NOT CMAKE_C_COMPILER_ID STREQUAL "MSVC")
        message(FATAL_ERROR "Windows OpenSSL source builds require a Windows host and the parent's desktop MSVC C compiler; no prebuilt fallback is available")
    endif()
    if(NOT CMAKE_GENERATOR MATCHES "^Visual Studio " OR NOT CMAKE_GENERATOR_INSTANCE)
        message(FATAL_ERROR "Select a Visual Studio instance with the parent CMake generator")
    endif()
    if(CMAKE_VS_PLATFORM_TOOLSET MATCHES "Clang" OR CMAKE_VS_PLATFORM_TOOLSET MATCHES "LLVM")
        message(FATAL_ERROR "The full Windows profile requires the selected MSVC toolset")
    endif()
    file(TO_CMAKE_PATH "${CMAKE_C_COMPILER}" compiler)
    string(TOLOWER "${compiler}" compiler_lower)
    string(REGEX MATCH "/msvc/([^/]+)/bin/host(x86|x64|arm64)/([^/]+)/cl\\.exe$" match "${compiler_lower}")
    if(NOT match)
        message(FATAL_ERROR "Cannot identify the selected MSVC tools and host architecture from ${CMAKE_C_COMPILER}")
    endif()
    set(vc_version "${CMAKE_MATCH_1}")
    set(host_arch "${CMAKE_MATCH_2}")
    set(compiler_path_arch "${CMAKE_MATCH_3}")
    set(platform "${CMAKE_VS_PLATFORM_NAME}")
    if(NOT platform)
        set(platform "${CMAKE_GENERATOR_PLATFORM}")
    endif()
    ossl_windows_target("${CMAKE_C_COMPILER_ARCHITECTURE_ID}" "${platform}" "${CMAKE_SIZEOF_VOID_P}" "${host_arch}")
    ossl_windows_normalize_architecture("${compiler_path_arch}" compiler_path_arch)
    if(NOT compiler_path_arch STREQUAL OSSL_ARCH)
        message(FATAL_ERROR "Selected MSVC compiler path disagrees with parent target architecture ${OSSL_ARCH}: ${compiler}")
    endif()
    set(vcvars "${CMAKE_GENERATOR_INSTANCE}/VC/Auxiliary/Build/vcvarsall.bat")
    set(nasm "")
    if(OSSL_USE_NASM)
        set(nasm "${CC_OPENSSL_COCOS_ROOT}/tools/nasm/nasm.exe")
    endif()
    file(TO_CMAKE_PATH "$ENV{SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe" powershell)
    set(perl "${CC_OPENSSL_PERL}")
    if(NOT perl)
        find_program(discovered_perl NAMES perl.exe NO_CACHE REQUIRED)
        set(perl "${discovered_perl}")
    endif()
    set(tools "${perl};${vcvars};${powershell}")
    if(OSSL_USE_NASM)
        list(APPEND tools "${nasm}")
    endif()
    foreach(path IN LISTS tools ITEMS "${CMAKE_C_COMPILER}")
        ossl_safe_value("${path}")
        if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
            message(FATAL_ERROR "Missing OpenSSL build tool: ${path}")
        endif()
    endforeach()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env LC_ALL=C LC_CTYPE=C LANG=C
        "${perl}" -e "print $^O, q{ }, $^V" RESULT_VARIABLE rc OUTPUT_VARIABLE perl_version ERROR_VARIABLE error)
    if(NOT rc EQUAL 0 OR NOT perl_version MATCHES "^MSWin32 ")
        message(FATAL_ERROR "OpenSSL VC build requires native Windows Perl: ${perl}: ${error}")
    endif()
    set(nasm_version "not used by ${OSSL_TARGET}")
    if(OSSL_USE_NASM)
        execute_process(COMMAND "${nasm}" -v RESULT_VARIABLE rc OUTPUT_VARIABLE nasm_version ERROR_VARIABLE error)
        if(NOT rc EQUAL 0 OR NOT nasm_version MATCHES "NASM version ")
            message(FATAL_ERROR "Project NASM is unusable: ${nasm}: ${error}")
        endif()
    endif()
    set(vc_args "${OSSL_VCVARS_ARCH} -vcvars_ver=${vc_version}")
    if(CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION)
        string(APPEND vc_args " ${CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION}")
    endif()
    ossl_safe_value("${vc_args}")
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/openssl-tools")
    set(probe "${CMAKE_CURRENT_BINARY_DIR}/openssl-tools/probe.cmd")
    file(WRITE "${probe}" "@echo off\ncall \"${vcvars}\" ${vc_args} >nul\nif errorlevel 1 exit /b 1\nwhere cl.exe\nwhere nmake.exe\nwhere link.exe\nwhere lib.exe\nwhere rc.exe\n")
    execute_process(COMMAND cmd.exe /d /c "${probe}" RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Unable to initialize selected VS environment: ${output}\n${error}")
    endif()
    string(REPLACE "\r" "" output "${output}")
    string(REPLACE "\n" ";" paths "${output}")
    foreach(tool cl nmake link lib rc)
        set(found "")
        foreach(path IN LISTS paths)
            if(path MATCHES "[/\\\\]${tool}\\.exe$" AND NOT found)
                file(TO_CMAKE_PATH "${path}" found)
            endif()
        endforeach()
        if(NOT found OR NOT EXISTS "${found}")
            message(FATAL_ERROR "Selected VS environment did not provide ${tool}.exe")
        endif()
        list(APPEND tools "${found}")
        set(${tool} "${found}")
    endforeach()
    string(TOLOWER "${cl}" selected_compiler_lower)
    if(NOT selected_compiler_lower STREQUAL compiler_lower)
        message(FATAL_ERROR "OpenSSL compiler ${cl} differs from parent ${CMAKE_C_COMPILER}")
    endif()
    if(CC_OPENSSL_MAKE AND NOT CC_OPENSSL_MAKE STREQUAL nmake)
        message(FATAL_ERROR "CC_OPENSSL_MAKE must be the nmake from the selected VS instance: ${nmake}")
    endif()
    set(make "${nmake}")
    set(jobs 1)
    set(extra_cflags "")
    set(make_version "selected VS nmake")
    if(CC_OPENSSL_BACKEND STREQUAL "jom")
        set(make "${CC_OPENSSL_JOM}")
        if(NOT make)
            find_program(discovered_jom NAMES jom.exe NO_CACHE)
            if(discovered_jom)
                set(make "${discovered_jom}")
            endif()
        endif()
        ossl_safe_value("${make}")
        if(NOT IS_ABSOLUTE "${make}" OR NOT EXISTS "${make}" OR IS_DIRECTORY "${make}")
            message(FATAL_ERROR "Explicit jom backend requires an existing local jom executable; set CC_OPENSSL_JOM (no download is performed)")
        endif()
        file(REAL_PATH "${make}" make)
        execute_process(COMMAND "${make}" /VERSION RESULT_VARIABLE rc
            OUTPUT_VARIABLE make_version ERROR_VARIABLE error)
        string(STRIP "${make_version}" make_version)
        if(NOT rc EQUAL 0 OR NOT make_version MATCHES "^jom version ([0-9]+\\.[0-9]+\\.[0-9]+)$")
            message(FATAL_ERROR "Unusable jom executable ${make}: ${make_version} ${error}")
        endif()
        if(CMAKE_MATCH_1 VERSION_LESS "1.1.0")
            message(FATAL_ERROR "jom 1.1.0 or newer is required for a shared recursive jobserver")
        endif()
        list(APPEND tools "${make}")
        set(jobs "${CC_OPENSSL_JOBS}")
        set(extra_cflags "/FS")
    endif()
    set(identity "VS=${CMAKE_GENERATOR_INSTANCE}\nVC=${vc_version}\nVCArgs=${vc_args}\nArch=${OSSL_ARCH}\nHostArch=${OSSL_HOST_ARCH}\nTarget=${OSSL_TARGET}\nDllSuffix=${OSSL_DLL_SUFFIX}\nSDK=${CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION}\nCC=${CMAKE_C_COMPILER_VERSION}\nPerl=${perl_version}\nNASM=${nasm_version}\nBackend=${CC_OPENSSL_BACKEND}\nMakeVersion=${make_version}\nRequestedJobs=${CC_OPENSSL_JOBS}\nJobs=${jobs}\nExtraCflags=${extra_cflags}\nMakePolicy=generated-and-install-serial,libs-and-modules-bounded,recursive-builtin-MAKE\n")
    set(tool_records "")
    foreach(path IN LISTS tools)
        ossl_safe_value("${path}")
        file(SHA256 "${path}" hash)
        string(APPEND identity "${path}=${hash}\n")
        string(APPEND tool_records "${hash}  ${path}\n")
    endforeach()
    string(SHA256 tool_hash "${identity}")
    foreach(name ARCH HOST_ARCH TARGET VCVARS_ARCH DLL_SUFFIX USE_NASM)
        set(OSSL_${name} "${OSSL_${name}}" PARENT_SCOPE)
    endforeach()
    foreach(pair "PERL|${perl}" "NASM|${nasm}" "VCVARS|${vcvars}" "VCARGS|${vc_args}"
        "MAKE|${make}" "NMAKE|${nmake}" "POWERSHELL|${powershell}" "BACKEND|${CC_OPENSSL_BACKEND}" "JOBS|${jobs}"
        "EXTRA_CFLAGS|${extra_cflags}" "MAKE_VERSION|${make_version}"
        "TOOLS|${tools}" "TOOL_RECORDS|${tool_records}" "TOOL_HASH|${tool_hash}" "TOOL_IDENTITY|${identity}")
        string(FIND "${pair}" "|" split)
        string(SUBSTRING "${pair}" 0 ${split} name)
        math(EXPR split "${split}+1")
        string(SUBSTRING "${pair}" ${split} -1 value)
        set(OSSL_${name} "${value}" PARENT_SCOPE)
    endforeach()
endfunction()
