include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLCommon.cmake")

# Run Configure and make in one native POSIX environment. A Windows CMake
# process must not combine WSL Perl/make with a Windows NDK or Windows paths.
function(ossl_portable_tools)
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows" AND CMAKE_SYSTEM_NAME STREQUAL "Android")
        include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/WindowsAndroidTools.cmake")
        ossl_windows_android_tools()
        foreach(name PERL MAKE JOBS TOOL_HASH TOOL_IDENTITY TOOL_RECORDS TOOLS TARGET TARGET_KEY PLATFORM_OPTIONS
                ENVIRONMENT SYSTEM_LIBRARIES READELF NM LIPO COMPILER RUNTIME_OPENSSLDIR WINDOWS_ANDROID
                MSYS_ROOT MSYS_PERL5LIB MSYS_MODULES_HASH ANDROID_NDK POWERSHELL)
            set(OSSL_${name} "${OSSL_${name}}" PARENT_SCOPE)
        endforeach()
        return()
    endif()
    if(NOT CMAKE_HOST_SYSTEM_NAME MATCHES "^(Linux|Darwin)$")
        message(FATAL_ERROR "OpenSSL Android/macOS source builds require native Linux/macOS CMake, Perl and make. For WSL configure inside Linux with a Linux NDK; the Windows NDK and Git Perl are not a supported mixed-host route. No tools are downloaded.")
    endif()
    if(NOT CMAKE_BUILD_TYPE MATCHES "^(Debug|Release)$" OR CMAKE_CONFIGURATION_TYPES)
        message(FATAL_ERROR "Portable OpenSSL requires a single-configuration Debug or Release build")
    endif()
    set(CC_OPENSSL_PERL "" CACHE FILEPATH "Native POSIX Perl executable")
    set(CC_OPENSSL_MAKE "" CACHE FILEPATH "Native POSIX make executable")
    set(CC_OPENSSL_JOBS "8" CACHE STRING "Maximum OpenSSL compile jobs (1 through 8)")
    set(CC_OPENSSL_RUNTIME_OPENSSLDIR "/usr/local/ssl" CACHE PATH "Target runtime OpenSSL directory, never the host stage prefix")
    if(NOT "${CC_OPENSSL_JOBS}" MATCHES "^[1-8]$")
        message(FATAL_ERROR "CC_OPENSSL_JOBS must be an integer from 1 through 8")
    endif()
    if(NOT CC_OPENSSL_RUNTIME_OPENSSLDIR MATCHES "^/" OR CC_OPENSSL_RUNTIME_OPENSSLDIR MATCHES "[;\r\n]")
        message(FATAL_ERROR "CC_OPENSSL_RUNTIME_OPENSSLDIR must be an absolute target POSIX path")
    endif()
    foreach(kind PERL MAKE)
        if(NOT CC_OPENSSL_${kind})
            if(kind STREQUAL "PERL")
                find_program(detected_${kind} NAMES perl REQUIRED NO_CMAKE_FIND_ROOT_PATH)
            else()
                find_program(detected_${kind} NAMES gmake make REQUIRED NO_CMAKE_FIND_ROOT_PATH)
            endif()
            set(CC_OPENSSL_${kind} "${detected_${kind}}" CACHE FILEPATH "Native POSIX ${kind}" FORCE)
        endif()
        if(NOT EXISTS "${CC_OPENSSL_${kind}}" OR NOT IS_ABSOLUTE "${CC_OPENSSL_${kind}}")
            message(FATAL_ERROR "CC_OPENSSL_${kind} must identify a native POSIX executable")
        endif()
        file(REAL_PATH "${CC_OPENSSL_${kind}}" tool_${kind})
    endforeach()
    execute_process(COMMAND "${tool_PERL}" -e "use File::Spec; use IPC::Cmd; use Locale::Maketext::Simple; use JSON::PP; use Pod::Usage; print qq($^O $^V\\n);"
        RESULT_VARIABLE rc OUTPUT_VARIABLE perl_version ERROR_VARIABLE perl_error)
    if(NOT rc EQUAL 0 OR NOT perl_version MATCHES "^(linux|darwin) v5\\.")
        message(FATAL_ERROR "Perl must match the POSIX host and provide upstream-required core modules: ${perl_version}${perl_error}")
    endif()
    execute_process(COMMAND "${tool_MAKE}" --version RESULT_VARIABLE rc OUTPUT_VARIABLE make_version ERROR_VARIABLE make_error)
    if(NOT rc EQUAL 0 OR NOT make_version MATCHES "GNU Make")
        message(FATAL_ERROR "Portable OpenSSL requires GNU make: ${make_version}${make_error}")
    endif()
    set(tools "${tool_PERL}" "${tool_MAKE}")
    set(identity "host=${CMAKE_HOST_SYSTEM_NAME}/${CMAKE_HOST_SYSTEM_PROCESSOR}\nperl=${perl_version}\nmake=${make_version}\n")
    # no-module embeds legacy in libcrypto, preserving both providers without
    # shipping a module whose search path refers to a host installation.
    set(platform_options no-shared no-module -fPIC)
    set(environment LC_ALL=C LANG=C)
    get_filename_component(perl_bin "${tool_PERL}" DIRECTORY)
    get_filename_component(make_bin "${tool_MAKE}" DIRECTORY)
    set(path_prefix "${perl_bin}:${make_bin}")
    if(CMAKE_SYSTEM_NAME STREQUAL "Android")
        if(CMAKE_ANDROID_ARCH_ABI STREQUAL "arm64-v8a")
            set(target android-arm64)
            set(triple aarch64-linux-android)
        elseif(CMAKE_ANDROID_ARCH_ABI STREQUAL "x86_64")
            set(target android-x86_64)
            set(triple x86_64-linux-android)
        else()
            message(FATAL_ERROR "OpenSSL Android ABI must be arm64-v8a or x86_64")
        endif()
        set(ndk "${CMAKE_ANDROID_NDK}")
        if(NOT ndk AND ANDROID_NDK)
            set(ndk "${ANDROID_NDK}")
        endif()
        if(NOT IS_ABSOLUTE "${ndk}" OR NOT EXISTS "${ndk}/source.properties")
            message(FATAL_ERROR "OpenSSL requires the NDK selected by the parent Android toolchain")
        endif()
        file(REAL_PATH "${ndk}" ndk)
        ossl_android_api(api)
        if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
            set(host_tag linux-x86_64)
        else()
            set(host_tag darwin-x86_64)
        endif()
        set(ndk_bin "${ndk}/toolchains/llvm/prebuilt/${host_tag}/bin")
        foreach(name clang llvm-ar llvm-ranlib llvm-readelf llvm-nm "${triple}${api}-clang")
            if(NOT EXISTS "${ndk_bin}/${name}")
                message(FATAL_ERROR "NDK does not contain the selected native host tool: ${ndk_bin}/${name}; do not substitute Windows executables in WSL")
            endif()
            list(APPEND tools "${ndk_bin}/${name}")
        endforeach()
        if(NOT EXISTS "${ndk_bin}/../sysroot/usr/include/android/api-level.h")
            message(FATAL_ERROR "Selected Android NDK sysroot is incomplete")
        endif()
        execute_process(COMMAND "${ndk_bin}/clang" --version RESULT_VARIABLE rc OUTPUT_VARIABLE compiler_version ERROR_VARIABLE compiler_error)
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "NDK clang cannot run on this host: ${compiler_error}")
        endif()
        file(READ "${ndk}/source.properties" ndk_version)
        list(APPEND tools "${ndk}/source.properties" "${ndk}/meta/platforms.json")
        list(APPEND platform_options "-D__ANDROID_API__=${api}")
        list(APPEND environment "ANDROID_NDK_ROOT=${ndk}")
        set(path_prefix "${ndk_bin}:${path_prefix}")
        set(target_key "android-${CMAKE_ANDROID_ARCH_ABI}-api${api}")
        set(system_libraries dl Threads::Threads)
        set(readelf "${ndk_bin}/llvm-readelf")
        set(nm "${ndk_bin}/llvm-nm")
        set(compiler "${ndk_bin}/${triple}${api}-clang")
        string(APPEND identity "NDK=${ndk}\n${ndk_version}\nclang=${compiler_version}\nABI=${CMAKE_ANDROID_ARCH_ABI}\nAPI=${api}\n")
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
        set(arch "${CMAKE_OSX_ARCHITECTURES}")
        if(NOT arch)
            set(arch "${CMAKE_SYSTEM_PROCESSOR}")
        endif()
        if(arch STREQUAL "arm64")
            set(target darwin64-arm64-cc)
        elseif(arch STREQUAL "x86_64")
            set(target darwin64-x86_64-cc)
        else()
            message(FATAL_ERROR "Build each macOS architecture separately: arm64 or x86_64; merge universal slices only after validation")
        endif()
        if(NOT CMAKE_OSX_DEPLOYMENT_TARGET MATCHES "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$")
            message(FATAL_ERROR "Set an explicit CMAKE_OSX_DEPLOYMENT_TARGET for the frozen macOS candidate")
        endif()
        find_program(xcrun NAMES xcrun REQUIRED NO_CMAKE_FIND_ROOT_PATH)
        find_program(xcodebuild NAMES xcodebuild REQUIRED NO_CMAKE_FIND_ROOT_PATH)
        set(sdk "${CMAKE_OSX_SYSROOT}")
        if(NOT IS_ABSOLUTE "${sdk}")
            if(NOT sdk)
                set(sdk macosx)
            endif()
            execute_process(COMMAND "${xcrun}" --sdk "${sdk}" --show-sdk-path RESULT_VARIABLE rc OUTPUT_VARIABLE sdk OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(NOT rc EQUAL 0)
                message(FATAL_ERROR "Cannot locate the explicitly selected macOS SDK")
            endif()
        endif()
        if(NOT EXISTS "${sdk}/SDKSettings.json")
            message(FATAL_ERROR "Invalid selected macOS SDK: ${sdk}")
        endif()
        execute_process(COMMAND "${xcrun}" --sdk "${sdk}" --find clang RESULT_VARIABLE rc OUTPUT_VARIABLE compiler OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT rc EQUAL 0 OR NOT EXISTS "${compiler}")
            message(FATAL_ERROR "Cannot locate clang for selected macOS SDK")
        endif()
        execute_process(COMMAND "${xcodebuild}" -version RESULT_VARIABLE rc OUTPUT_VARIABLE xcode_version ERROR_VARIABLE xcode_error)
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "Xcode toolchain is unavailable: ${xcode_error}")
        endif()
        execute_process(COMMAND "${compiler}" --version RESULT_VARIABLE rc OUTPUT_VARIABLE compiler_version)
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "Selected macOS compiler cannot run")
        endif()
        foreach(name ar ranlib nm lipo)
            execute_process(COMMAND "${xcrun}" --sdk "${sdk}" --find "${name}"
                RESULT_VARIABLE rc OUTPUT_VARIABLE mac_${name} OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(NOT rc EQUAL 0 OR NOT EXISTS "${mac_${name}}")
                message(FATAL_ERROR "Cannot locate selected Xcode ${name}")
            endif()
            list(APPEND tools "${mac_${name}}")
        endforeach()
        set(nm "${mac_nm}")
        set(lipo "${mac_lipo}")
        list(APPEND tools "${compiler}" "${xcrun}" "${xcodebuild}" "${sdk}/SDKSettings.json")
        # Each flag is a Configure argument; paths stay separate argv items.
        list(APPEND platform_options -isysroot "${sdk}" "-mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
        list(APPEND environment "CC=${compiler}" "AR=${mac_ar}" "RANLIB=${mac_ranlib}"
            "SDKROOT=${sdk}" "MACOSX_DEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET}")
        string(SHA256 sdk_id "${sdk}\n${xcode_version}")
        string(SUBSTRING "${sdk_id}" 0 12 sdk_key)
        set(target_key "macos-${arch}-sdk${sdk_key}-min${CMAKE_OSX_DEPLOYMENT_TARGET}")
        set(system_libraries Threads::Threads)
        set(readelf "")
        string(APPEND identity "SDK=${sdk}\nXcode=${xcode_version}\nclang=${compiler_version}\narch=${arch}\ndeployment=${CMAKE_OSX_DEPLOYMENT_TARGET}\n")
    else()
        message(FATAL_ERROR "Portable OpenSSL supports Android and native macOS only")
    endif()
    list(APPEND environment "PATH=${path_prefix}:$ENV{PATH}")
    set(records "")
    list(REMOVE_DUPLICATES tools)
    foreach(tool IN LISTS tools)
        ossl_safe_value("${tool}")
        file(SHA256 "${tool}" hash)
        string(APPEND records "${hash}  ${tool}\n")
    endforeach()
    string(APPEND identity "${records}target=${target}\noptions=${platform_options}\nconfig=${CMAKE_BUILD_TYPE}\njobs=${CC_OPENSSL_JOBS}\nopenssldir=${CC_OPENSSL_RUNTIME_OPENSSLDIR}\n")
    string(SHA256 tool_hash "${identity}")
    foreach(pair "PERL|${tool_PERL}" "MAKE|${tool_MAKE}" "JOBS|${CC_OPENSSL_JOBS}"
        "TOOL_HASH|${tool_hash}" "TOOL_IDENTITY|${identity}" "TOOL_RECORDS|${records}"
        "TOOLS|${tools}" "TARGET|${target}" "TARGET_KEY|${target_key}"
        "PLATFORM_OPTIONS|${platform_options}" "ENVIRONMENT|${environment}"
        "SYSTEM_LIBRARIES|${system_libraries}" "READELF|${readelf}" "NM|${nm}" "LIPO|${lipo}"
        "COMPILER|${compiler}" "RUNTIME_OPENSSLDIR|${CC_OPENSSL_RUNTIME_OPENSSLDIR}")
        string(FIND "${pair}" "|" split)
        string(SUBSTRING "${pair}" 0 ${split} name)
        math(EXPR split "${split}+1")
        string(SUBSTRING "${pair}" ${split} -1 value)
        set(OSSL_${name} "${value}" PARENT_SCOPE)
    endforeach()
endfunction()
