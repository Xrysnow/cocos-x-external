include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/WindowsAndroidTools.cmake")

function(ossl_windows_android_run name)
    ossl_msys_path("${OSSL_ANDROID_NDK}" ndk)
    ossl_msys_path("${OSSL_ANDROID_NDK}/toolchains/llvm/prebuilt/windows-x86_64/bin" ndk_bin)
    set(overlay "")
    if(OSSL_MSYS_PERL5LIB)
        ossl_msys_path("${OSSL_MSYS_PERL5LIB}" overlay)
    endif()
    ossl_sh_quote("${overlay}" overlay)
    ossl_sh_quote("${ndk}" ndk)
    ossl_sh_quote("${ndk_bin}" ndk_bin)
    set(script "#!/usr/bin/env bash\nset -e\nexport LC_ALL=C LANG=C\nexport PERL5LIB=${overlay}\nexport ANDROID_NDK_ROOT=${ndk}\nexport PATH=${ndk_bin}:/usr/bin:/bin\nexport MSYS2_ARG_CONV_EXCL='*'\nexport MSYS2_ENV_CONV_EXCL='PERL5LIB;ANDROID_NDK_ROOT'\n")
    set(command "")
    set(first TRUE)
    set(native_tools FALSE)
    foreach(arg IN LISTS ARGN)
        set(original "${arg}")
        if(first AND (original STREQUAL OSSL_READELF OR original STREQUAL OSSL_NM))
            set(native_tools TRUE)
        endif()
        if(arg MATCHES "^--prefix=([A-Za-z]:/.*)$")
            ossl_msys_path("${CMAKE_MATCH_1}" arg)
            set(arg "--prefix=${arg}")
        elseif(arg MATCHES "^[A-Za-z]:/" AND (first OR NOT native_tools))
            ossl_msys_path("${arg}" arg)
        endif()
        ossl_sh_quote("${arg}" quoted)
        string(APPEND command "${quoted} ")
        if(first AND original STREQUAL OSSL_MAKE)
            ossl_sh_quote("SHELL=${OSSL_MSYS_ROOT}/usr/bin/sh.exe" shell_arg)
            string(APPEND command "${shell_arg} ")
        endif()
        set(first FALSE)
    endforeach()
    string(APPEND script "exec ${command}\n")
    set(script_path "${log_root}/${name}.sh")
    file(WRITE "${script_path}" "${script}")
    ossl_msys_path("${script_path}" script_arg)
    set(cmd_path "${log_root}/${name}.cmd")
    file(WRITE "${cmd_path}" "@echo off\r\n\"${OSSL_MSYS_ROOT}/usr/bin/bash.exe\" --noprofile --norc \"${script_arg}\"\r\nexit /b %errorlevel%\r\n")
    execute_process(COMMAND "${OSSL_POWERSHELL}" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass
        -File "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunWindowsCommand.ps1" -Script "${cmd_path}"
        WORKING_DIRECTORY "${OSSL_ROOT}/build" RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(command_rc "${rc}" PARENT_SCOPE)
    set(command_output "${output}" PARENT_SCOPE)
    set(command_error "${error}" PARENT_SCOPE)
endfunction()
