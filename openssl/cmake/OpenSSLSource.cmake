include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLCommon.cmake")

# The original archive's executable modes cannot be represented by a Windows
# file copy. Pin the retained executable paths separately from upstream bytes.
function(ossl_bundled_executables source out_files)
    set(sidecar "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../source-executables.txt")
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../prune-manifest.json" prune)
    string(JSON expected GET "${prune}" executables_sha256)
    file(SHA256 "${sidecar}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Bundled OpenSSL executable list differs from its pinned SHA256")
    endif()
    file(STRINGS "${sidecar}" executables ENCODING UTF-8)
    foreach(relative IN LISTS executables)
        ossl_safe_value("${relative}")
        cmake_path(NORMAL_PATH relative OUTPUT_VARIABLE normalized)
        if(IS_ABSOLUTE "${relative}" OR NOT relative MATCHES "^[A-Za-z0-9_./+-]+$" OR
            NOT relative STREQUAL normalized OR relative MATCHES "(^|/)\\.\\.?(/|$)")
            message(FATAL_ERROR "Invalid bundled executable path: ${relative}")
        endif()
        if(NOT EXISTS "${source}/${relative}" OR IS_DIRECTORY "${source}/${relative}" OR IS_SYMLINK "${source}/${relative}")
            message(FATAL_ERROR "Bundled executable path must name a retained regular file: ${relative}")
        endif()
    endforeach()
    set(${out_files} "${executables}" PARENT_SCOPE)
endfunction()

# Git retains files, not empty directories. Only the manifest's empty-directory
# whitelist may be absent from bundled input; all bytes and all other paths
# still participate in the same frozen pruned pins as the prepared snapshot.
function(ossl_validate_bundled_source source out_hash out_inventory)
    if(NOT IS_DIRECTORY "${source}" OR NOT EXISTS "${source}/Configure")
        message(FATAL_ERROR "Bundled OpenSSL source is missing: ${source}. Restore the pinned openssl/src tree; external source overrides are not supported.")
    endif()
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../prune-manifest.json" prune)
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../source-manifest.json" manifest)
    string(JSON full_expected GET "${prune}" full_source_sha256)
    string(JSON pinned_full GET "${manifest}" full_source_sha256)
    if(NOT full_expected STREQUAL pinned_full)
        message(FATAL_ERROR "Prune manifest does not describe the pinned complete OpenSSL source")
    endif()
    string(JSON expected GET "${prune}" pruned_source_sha256)
    string(JSON expected_directories GET "${prune}" pruned_directories_sha256)
    ossl_inventory("${source}" actual inventory)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Bundled OpenSSL file inventory differs from the pinned pruned manifest; restore the original bytes and file set")
    endif()
    ossl_directory_inventory("${source}" unused directories)
    string(REPLACE "\n" ";" directories "${directories}")
    list(FILTER directories EXCLUDE REGEX "^$")
    string(JSON count LENGTH "${prune}" retained_empty_directories)
    if(count GREATER 0)
        math(EXPR last "${count}-1")
        foreach(index RANGE 0 ${last})
            string(JSON relative GET "${prune}" retained_empty_directories ${index})
            ossl_safe_value("${relative}")
            cmake_path(NORMAL_PATH relative OUTPUT_VARIABLE normalized)
            if(IS_ABSOLUTE "${relative}" OR relative STREQUAL "" OR
                NOT relative STREQUAL normalized OR relative MATCHES "(^|/)\\.\\.?(/|$)")
                message(FATAL_ERROR "Invalid bundled empty-directory whitelist entry: ${relative}")
            endif()
            if(EXISTS "${source}/${relative}")
                if(NOT IS_DIRECTORY "${source}/${relative}")
                    message(FATAL_ERROR "Bundled empty-directory entry is not a directory: ${relative}")
                endif()
                file(GLOB contents LIST_DIRECTORIES TRUE "${source}/${relative}/*" "${source}/${relative}/.*")
                if(contents)
                    message(FATAL_ERROR "Bundled whitelisted directory must remain empty: ${relative}")
                endif()
            else()
                list(APPEND directories "${relative}")
            endif()
        endforeach()
    endif()
    list(SORT directories)
    set(directory_inventory "")
    foreach(relative IN LISTS directories)
        string(APPEND directory_inventory "${relative}\n")
    endforeach()
    string(SHA256 actual_directories "${directory_inventory}")
    if(NOT actual_directories STREQUAL expected_directories)
        message(FATAL_ERROR "Bundled OpenSSL directory inventory differs from the pinned pruned manifest; only whitelisted empty directories may be absent")
    endif()
    ossl_bundled_executables("${source}" unused_executables)
    set(${out_hash} "${actual}" PARENT_SCOPE)
    set(${out_inventory} "${inventory}" PARENT_SCOPE)
endfunction()

# Both layouts are exact snapshots of the pinned archive. A shortened tree is
# accepted only with the matching program/engine selections, never by ignoring
# arbitrary missing files or accepting changed upstream build.info files.
function(ossl_validate_source source layout profile build_tests build_demos out_hash out_inventory)
    if(NOT layout MATCHES "^(full|pruned)$")
        message(FATAL_ERROR "OpenSSL source layout must be full or pruned")
    endif()
    if(NOT EXISTS "${source}/Configure" OR EXISTS "${source}/configdata.pm")
        message(FATAL_ERROR "Use an unconfigured OpenSSL source snapshot")
    endif()
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../source-manifest.json" manifest)
    file(READ "${source}/VERSION.dat" version)
    ossl_source_version(OSSL_SOURCE_VERSION)
    string(REPLACE "." ";" version_parts "${OSSL_SOURCE_VERSION}")
    list(GET version_parts 0 major)
    list(GET version_parts 1 minor)
    list(GET version_parts 2 patch)
    foreach(part "MAJOR=${major}" "MINOR=${minor}" "PATCH=${patch}")
        if(NOT version MATCHES "(^|\n)${part}(\r?\n|$)")
            message(FATAL_ERROR "Source VERSION.dat must identify OpenSSL ${OSSL_SOURCE_VERSION}")
        endif()
    endforeach()
    if(layout STREQUAL "pruned")
        if(build_tests OR build_demos OR NOT profile STREQUAL "peripheral")
            message(FATAL_ERROR "Pruned OpenSSL requires profile=peripheral with tests and demos disabled")
        endif()
        file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../prune-manifest.json" prune)
        string(JSON expected GET "${prune}" pruned_source_sha256)
        string(JSON expected_directories GET "${prune}" pruned_directories_sha256)
        string(JSON full_expected GET "${prune}" full_source_sha256)
        string(JSON pinned_full GET "${manifest}" full_source_sha256)
        if(NOT pinned_full STREQUAL full_expected)
            message(FATAL_ERROR "Prune manifest does not describe the pinned complete OpenSSL source")
        endif()
        foreach(field excluded_directories excluded_files)
            string(JSON count LENGTH "${prune}" ${field})
            math(EXPR last "${count}-1")
            foreach(index RANGE 0 ${last})
                string(JSON excluded GET "${prune}" ${field} ${index})
                if(EXISTS "${source}/${excluded}")
                    message(FATAL_ERROR "Pruned OpenSSL contains an excluded path: ${excluded}")
                endif()
            endforeach()
        endforeach()
        string(JSON count LENGTH "${prune}" excluded_empty_directories)
        math(EXPR last "${count}-1")
        foreach(index RANGE 0 ${last})
            string(JSON excluded GET "${prune}" excluded_empty_directories ${index})
            if(EXISTS "${source}/${excluded}")
                message(FATAL_ERROR "Pruned OpenSSL contains an excluded empty test directory: ${excluded}")
            endif()
        endforeach()
    else()
        string(JSON expected GET "${manifest}" full_source_sha256)
        string(JSON expected_directories GET "${manifest}" full_directories_sha256)
        foreach(required LICENSE.txt test/build.info demos/build.info engines/build.info)
            if(NOT EXISTS "${source}/${required}")
                message(FATAL_ERROR "Complete OpenSSL source file missing: ${required}")
            endif()
        endforeach()
    endif()
    ossl_directory_inventory("${source}" directories)
    if(NOT directories STREQUAL expected_directories)
        message(FATAL_ERROR "OpenSSL ${layout} directory inventory differs from its pinned manifest, including empty directories")
    endif()
    ossl_inventory("${source}" actual inventory)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "OpenSSL ${layout} source inventory differs from its pinned manifest; do not patch or configure the input tree")
    endif()
    set(${out_hash} "${actual}" PARENT_SCOPE)
    set(${out_inventory} "${inventory}" PARENT_SCOPE)
endfunction()
