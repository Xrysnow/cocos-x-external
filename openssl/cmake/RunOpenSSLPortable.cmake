cmake_minimum_required(VERSION 3.28)
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLCommon.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLProfiles.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLSource.cmake")
if(NOT DEFINED INPUT OR NOT EXISTS "${INPUT}" OR NOT MODE MATCHES "^(BOOTSTRAP|BUILD)$")
    message(FATAL_ERROR "Pass -DINPUT=<generated input.cmake> -DMODE=BOOTSTRAP|BUILD")
endif()
include("${INPUT}")
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows" AND OSSL_WINDOWS_ANDROID AND OSSL_CONFIG MATCHES "^(Debug|Release)$"
   AND OSSL_TARGET MATCHES "^android-(arm|arm64|x86|x86_64)$")
    include("${CMAKE_CURRENT_LIST_DIR}/WindowsAndroidCommand.cmake")
elseif(NOT CMAKE_HOST_SYSTEM_NAME MATCHES "^(Linux|Darwin)$")
    message(FATAL_ERROR "Portable OpenSSL must run inside the selected native POSIX host")
endif()
file(LOCK "${OSSL_ROOT}/build.lock" GUARD PROCESS TIMEOUT 600 RESULT_VARIABLE lock_result)
if(NOT lock_result STREQUAL "0")
    message(FATAL_ERROR "Cannot lock ${OSSL_ROOT}: ${lock_result}")
endif()
ossl_stage_valid(stage_valid)
file(REMOVE "${OSSL_ROOT}/ready")
if(OSSL_WINDOWS_ANDROID)
    if(OSSL_MSYS_PERL5LIB)
        ossl_inventory("${OSSL_MSYS_PERL5LIB}" current_module_hash unused_modules)
    else()
        set(current_module_hash "none")
    endif()
    if(NOT current_module_hash STREQUAL OSSL_MSYS_MODULES_HASH)
        message(FATAL_ERROR "MSYS Perl overlay inventory changed; reconfigure consumer probes before building")
    endif()
endif()
if(NOT OSSL_CONFIG MATCHES "^(Debug|Release)$" OR NOT "${OSSL_JOBS}" MATCHES "^[1-8]$"
    OR NOT OSSL_TARGET MATCHES "^(android-(arm|arm64|x86|x86_64)|linux-(x86_64|aarch64|x86|armv4)|darwin64-(arm64|x86_64)-cc|ios(64)?-xcrun|iossimulator-(arm64|x86_64|i386)-xcrun)$")
    message(FATAL_ERROR "Invalid portable OpenSSL target/configuration/jobs; reconfigure the parent project")
endif()
if(NOT OSSL_NM OR NOT OSSL_NM_OPTIONS
    OR (OSSL_FORMAT STREQUAL "ELF" AND (NOT OSSL_READELF OR NOT OSSL_ELF_CLASS MATCHES "^ELF(32|64)$" OR NOT OSSL_ELF_MACHINE))
    OR (OSSL_FORMAT STREQUAL "MachO" AND (NOT OSSL_LIPO OR NOT OSSL_ARCH MATCHES "^(arm64|x86_64|armv7|i386)$"))
    OR NOT OSSL_FORMAT MATCHES "^(ELF|MachO)$")
    message(FATAL_ERROR "Missing target-specific OpenSSL archive inspection metadata; reconfigure the parent project")
endif()
ossl_configure_options("${OSSL_PROFILE}" "${OSSL_BUILD_TESTS}" "${OSSL_BUILD_DEMOS}" expected_options)
if(NOT OSSL_OPTIONS STREQUAL expected_options)
    message(FATAL_ERROR "OpenSSL feature options changed; reconfigure the parent project")
endif()
ossl_validate_source("${OSSL_SOURCE}" "${OSSL_SOURCE_LAYOUT}" "${OSSL_PROFILE}"
    "${OSSL_BUILD_TESTS}" "${OSSL_BUILD_DEMOS}" source_hash unused)
if(OSSL_BUNDLED_SOURCE)
    ossl_validate_bundled_source("${OSSL_BUNDLED_SOURCE}" bundled_hash unused)
    if(NOT bundled_hash STREQUAL source_hash)
        message(FATAL_ERROR "Bundled OpenSSL input and prepared snapshot identities differ; reconfigure the parent project")
    endif()
endif()
ossl_adapter_hash(adapter_hash)
if(NOT source_hash STREQUAL OSSL_SOURCE_HASH OR NOT adapter_hash STREQUAL OSSL_ADAPTER_HASH)
    message(FATAL_ERROR "OpenSSL source/adapter identity changed; reconfigure consumer probes before building")
endif()
string(REPLACE "\n" ";" records "${OSSL_TOOL_RECORDS}")
foreach(record IN LISTS records)
    if(record MATCHES "^([0-9a-f]+)  (.+)$")
        set(expected "${CMAKE_MATCH_1}")
        set(path "${CMAKE_MATCH_2}")
        if(NOT EXISTS "${path}")
            message(FATAL_ERROR "OpenSSL tool missing; reconfigure: ${path}")
        endif()
        file(SHA256 "${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "OpenSSL tool identity changed; reconfigure: ${path}")
        endif()
    endif()
endforeach()
set(build_source "${OSSL_ROOT}/source")
if(NOT EXISTS "${build_source}")
    file(COPY "${OSSL_SOURCE}/" DESTINATION "${build_source}")
endif()
ossl_validate_source("${build_source}" "${OSSL_SOURCE_LAYOUT}" "${OSSL_PROFILE}"
    "${OSSL_BUILD_TESTS}" "${OSSL_BUILD_DEMOS}" mirror_hash unused)
if(NOT mirror_hash STREQUAL OSSL_SOURCE_HASH)
    message(FATAL_ERROR "Private OpenSSL source snapshot changed; choose a fresh work root")
endif()
set(configuration_valid FALSE)
if(EXISTS "${OSSL_ROOT}/build/Makefile" AND EXISTS "${OSSL_ROOT}/build/configdata.pm"
    AND EXISTS "${OSSL_ROOT}/configured-identity.txt")
    file(SHA256 "${OSSL_ROOT}/build/Makefile" make_hash)
    file(SHA256 "${OSSL_ROOT}/build/configdata.pm" config_hash)
    file(READ "${OSSL_ROOT}/configured-identity.txt" configured)
    if(configured STREQUAL "${OSSL_ID}\n${make_hash}\n${config_hash}\n")
        set(configuration_valid TRUE)
    endif()
endif()
if(MODE STREQUAL "BOOTSTRAP" AND stage_valid AND configuration_valid
    AND NOT EXISTS "${OSSL_ROOT}/failed" AND NOT EXISTS "${OSSL_ROOT}/running")
    ossl_inventory("${OSSL_STAGE}" hash unused)
    file(WRITE "${OSSL_ROOT}/ready" "${OSSL_ID}\n${hash}\n")
    message(STATUS "OpenSSL ${OSSL_CONFIG} portable stage already verified")
    return()
endif()
file(MAKE_DIRECTORY "${OSSL_ROOT}/build" "${OSSL_ROOT}/logs")
string(TIMESTAMP now "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 6 ALPHABET 0123456789abcdef nonce)
set(log_root "${OSSL_ROOT}/logs/${now}-${nonce}-${MODE}")
file(MAKE_DIRECTORY "${log_root}")
if(EXISTS "${OSSL_ROOT}/running")
    file(WRITE "${OSSL_ROOT}/failed" "Interrupted portable OpenSSL invocation\n")
endif()
if(NOT configuration_valid AND EXISTS "${OSSL_ROOT}/build/configdata.pm")
    file(WRITE "${OSSL_ROOT}/failed" "Configuration identity missing or changed\n")
endif()
if(EXISTS "${OSSL_ROOT}/failed" AND EXISTS "${OSSL_ROOT}/build")
    file(REAL_PATH "${OSSL_ROOT}" checked_root)
    file(REAL_PATH "${OSSL_ROOT}/build" checked_build)
    if(NOT checked_build STREQUAL "${checked_root}/build" OR IS_SYMLINK "${OSSL_ROOT}/build")
        message(FATAL_ERROR "Refusing recovery outside the isolated portable build root")
    endif()
    file(RENAME "${checked_build}" "${checked_root}/failed-build-${now}-${nonce}")
    file(MAKE_DIRECTORY "${OSSL_ROOT}/build")
endif()
file(WRITE "${OSSL_ROOT}/running" "${MODE}\n${log_root}\n")
set(environment_text "")
foreach(record IN LISTS OSSL_ENVIRONMENT)
    if(record MATCHES "[\r\n]")
        message(FATAL_ERROR "OpenSSL environment values must not contain line breaks")
    endif()
    string(APPEND environment_text "${record}\n")
endforeach()
file(WRITE "${log_root}/environment.txt" "${environment_text}")
function(ossl_portable_run name)
    message(STATUS "OpenSSL ${OSSL_CONFIG}: ${name} (${log_root}/${name}.log)")
    string(TIMESTAMP started "%s" UTC)
    if(OSSL_WINDOWS_ANDROID)
        ossl_windows_android_run("${name}" ${ARGN})
        set(rc "${command_rc}")
        set(output "${command_output}")
        set(error "${command_error}")
    else()
        execute_process(COMMAND "${OSSL_PERL}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunPortableCommand.pl"
            "${log_root}/environment.txt" ${ARGN}
            WORKING_DIRECTORY "${OSSL_ROOT}/build" RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
    endif()
    string(TIMESTAMP finished "%s" UTC)
    math(EXPR elapsed "${finished}-${started}")
    file(WRITE "${log_root}/${name}.log" "${output}")
    file(WRITE "${log_root}/${name}.stderr.log" "${error}")
    file(APPEND "${log_root}/commands.txt" "${name}: ${ARGN}\nenvironment=${OSSL_ENVIRONMENT}\nexit=${rc}\nelapsed_seconds=${elapsed}\n")
    if(NOT rc EQUAL 0)
        file(WRITE "${OSSL_ROOT}/failed" "${name}\n${log_root}\nexit=${rc}\n")
        message(FATAL_ERROR "Portable OpenSSL ${name} failed (${rc}); inspect ${log_root}")
    endif()
endfunction()
if(NOT EXISTS "${OSSL_ROOT}/build/configdata.pm" OR NOT EXISTS "${OSSL_ROOT}/build/Makefile")
    string(TOLOWER "${OSSL_CONFIG}" config)
    # A target runtime directory is independent of the host installation prefix.
    ossl_portable_run(configure "${OSSL_PERL}" ../source/Configure "${OSSL_TARGET}" "--${config}"
        "--prefix=${OSSL_STAGE}" "--openssldir=${OSSL_RUNTIME_OPENSSLDIR}" --libdir=lib
        ${OSSL_OPTIONS} ${OSSL_PLATFORM_OPTIONS})
    file(SHA256 "${OSSL_ROOT}/build/Makefile" make_hash)
    file(SHA256 "${OSSL_ROOT}/build/configdata.pm" config_hash)
    file(WRITE "${OSSL_ROOT}/configured-identity.txt" "${OSSL_ID}\n${make_hash}\n${config_hash}\n")
endif()
file(READ "${OSSL_ROOT}/build/Makefile" makefile)
if(NOT makefile MATCHES "CFLAGS=[^\n]*-fPIC")
    message(FATAL_ERROR "Portable OpenSSL must retain PIC")
endif()
ossl_portable_run(build-generated "${OSSL_MAKE}" -j1 build_generated)
ossl_portable_run(build-libs "${OSSL_MAKE}" "-j${OSSL_JOBS}" build_libs)
ossl_portable_run(build-modules "${OSSL_MAKE}" "-j${OSSL_JOBS}" build_modules)
ossl_portable_run(install-dev "${OSSL_MAKE}" -j1 install_dev)
# no-module keeps the default and legacy implementations in the static library;
# there is deliberately no device/provider module copy or host module fallback.
foreach(file include/openssl/configuration.h include/openssl/opensslv.h include/openssl/ssl.h lib/libcrypto.a lib/libssl.a)
    if(NOT EXISTS "${OSSL_STAGE}/${file}")
        message(FATAL_ERROR "Incomplete portable OpenSSL stage: ${file}")
    endif()
endforeach()
file(GLOB public_headers "${build_source}/include/openssl/*.h" "${OSSL_ROOT}/build/include/openssl/*.h")
foreach(header IN LISTS public_headers)
    get_filename_component(name "${header}" NAME)
    if(NOT name MATCHES "^__DECC_" AND NOT EXISTS "${OSSL_STAGE}/include/openssl/${name}")
        message(FATAL_ERROR "Public OpenSSL header was not installed: ${name}")
    endif()
endforeach()
file(SHA256 "${OSSL_STAGE}/include/openssl/configuration.h" staged)
file(SHA256 "${OSSL_ROOT}/build/include/openssl/configuration.h" generated)
if(NOT staged STREQUAL generated)
    message(FATAL_ERROR "Portable generated and staged feature headers differ")
endif()
file(READ "${OSSL_STAGE}/include/openssl/configuration.h" feature_header)
ossl_portable_run(inspect-options "${OSSL_PERL}" "${CMAKE_CURRENT_LIST_DIR}/CheckOpenSSLOptions.pl" ${OSSL_OPTIONS})
foreach(option IN LISTS OSSL_OPTIONS)
    # Configure deliberately excludes fips from openssl_feature_defines.
    if(option STREQUAL "no-fips")
        continue()
    endif()
    string(REPLACE "-" "_" macro "${option}")
    string(TOUPPER "OPENSSL_${macro}" macro)
    if(NOT feature_header MATCHES "#[ \t]*define[ \t]+${macro}([ \r\n]|$)")
        message(FATAL_ERROR "Portable profile macro missing: ${macro}")
    endif()
endforeach()
if(feature_header MATCHES "#[ \t]*define[ \t]+OPENSSL_NO_(LEGACY|ASM|DEPRECATED)([ \r\n]|$)")
    message(FATAL_ERROR "Portable OpenSSL unexpectedly removed a retained capability")
endif()
if(OSSL_FORMAT STREQUAL "ELF")
    foreach(library crypto ssl)
        ossl_portable_run("inspect-${library}" "${OSSL_READELF}" -h "${OSSL_STAGE}/lib/lib${library}.a")
        file(READ "${log_root}/inspect-${library}.log" headers)
        string(REGEX MATCHALL "Class:[^\r\n]+" classes "${headers}")
        string(REGEX MATCHALL "Machine:[^\r\n]+" machines "${headers}")
        list(LENGTH classes class_count)
        list(LENGTH machines machine_count)
        if(class_count EQUAL 0 OR NOT class_count EQUAL machine_count)
            message(FATAL_ERROR "Missing ELF member headers in OpenSSL ${library} archive")
        endif()
        foreach(class IN LISTS classes)
            if(NOT class MATCHES "^Class:[ \t]+${OSSL_ELF_CLASS}[ \t]*$")
                message(FATAL_ERROR "Wrong ELF class in OpenSSL ${library} archive: ${class}; expected ${OSSL_ELF_CLASS}")
            endif()
        endforeach()
        foreach(machine IN LISTS machines)
            if(NOT machine MATCHES "^Machine:[ \t]+${OSSL_ELF_MACHINE}[ \t]*$")
                message(FATAL_ERROR "Wrong machine in OpenSSL ${library} archive: ${machine}; expected ${OSSL_ELF_MACHINE}")
            endif()
        endforeach()
    endforeach()
endif()
if(OSSL_FORMAT STREQUAL "MachO")
    foreach(library crypto ssl)
        ossl_portable_run("inspect-${library}" "${OSSL_LIPO}" -archs "${OSSL_STAGE}/lib/lib${library}.a")
        file(READ "${log_root}/inspect-${library}.log" archive_arch)
        string(STRIP "${archive_arch}" archive_arch)
        if(NOT archive_arch STREQUAL OSSL_ARCH)
            message(FATAL_ERROR "Portable Apple archive does not have exactly the selected architecture '${OSSL_ARCH}': ${archive_arch}")
        endif()
    endforeach()
endif()
ossl_portable_run(inspect-symbols "${OSSL_NM}" ${OSSL_NM_OPTIONS} "${OSSL_STAGE}/lib/libcrypto.a")
file(READ "${log_root}/inspect-symbols.log" symbols)
foreach(symbol AES_set_encrypt_key MD5_Init EVP_MD_fetch OSSL_PROVIDER_load ossl_legacy_provider_init)
    if(NOT symbols MATCHES "[ \t]_?${symbol}([ \r\n]|$)")
        message(FATAL_ERROR "Retained static OpenSSL symbol missing: ${symbol}")
    endif()
endforeach()
ossl_inventory("${OSSL_STAGE}" stage_hash stage_inventory)
file(SHA256 "${OSSL_ROOT}/build/Makefile" make_hash)
file(SHA256 "${OSSL_ROOT}/build/configdata.pm" config_hash)
file(WRITE "${OSSL_ROOT}/configured-identity.txt" "${OSSL_ID}\n${make_hash}\n${config_hash}\n")
file(WRITE "${OSSL_ROOT}/stage-manifest.sha256" "${stage_inventory}")
file(WRITE "${log_root}/result.txt" "identity=${OSSL_ID}\nsource=${source_hash}\nadapter=${adapter_hash}\nstage=${stage_hash}\ntarget=${OSSL_TARGET}\nconfiguration=${OSSL_CONFIG}\noptions=${OSSL_OPTIONS};${OSSL_PLATFORM_OPTIONS}\nprovider=default+legacy built-in\nresult=ready\n")
file(WRITE "${OSSL_ROOT}/ready.tmp" "${OSSL_ID}\n${stage_hash}\n")
file(RENAME "${OSSL_ROOT}/ready.tmp" "${OSSL_ROOT}/ready")
file(REMOVE "${OSSL_ROOT}/failed" "${OSSL_ROOT}/running")
message(STATUS "Portable OpenSSL ${OSSL_CONFIG} ready: ${OSSL_STAGE}")
