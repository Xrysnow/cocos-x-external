cmake_minimum_required(VERSION 3.28)
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLCommon.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLProfiles.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLSource.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/WindowsTargets.cmake")
if(NOT DEFINED INPUT OR NOT EXISTS "${INPUT}" OR NOT MODE MATCHES "^(BOOTSTRAP|BUILD|TEST|TEST_FULL)$")
    message(FATAL_ERROR "Pass -DINPUT=<generated input.cmake> -DMODE=BOOTSTRAP|BUILD|TEST|TEST_FULL")
endif()
include("${INPUT}")
if(MODE STREQUAL "TEST_FULL")
    # Full upstream tests/apps get a separate complete build and source copy.
    # Never install test-build DLLs over the artifacts consumed by the engine.
    set(OSSL_ROOT "${OSSL_ROOT}-official-tests")
    set(OSSL_STAGE "${OSSL_ROOT}/stage")
    string(SHA256 OSSL_ID "${OSSL_ID}\nfull-official-tests\n${OSSL_ROOT}")
    file(MAKE_DIRECTORY "${OSSL_ROOT}")
endif()
file(LOCK "${OSSL_ROOT}/build.lock" GUARD PROCESS TIMEOUT 600 RESULT_VARIABLE lock_result)
if(NOT lock_result STREQUAL "0")
    message(FATAL_ERROR "Cannot lock ${OSSL_ROOT}: ${lock_result}")
endif()
ossl_stage_valid(stage_valid)
# Even when rejecting stale inputs, no success marker may survive.
file(REMOVE "${OSSL_ROOT}/ready")
set(input_target "${OSSL_TARGET}")
set(input_suffix "${OSSL_DLL_SUFFIX}")
set(input_vcvars_arch "${OSSL_VCVARS_ARCH}")
set(input_use_nasm "${OSSL_USE_NASM}")
if(OSSL_ARCH STREQUAL "x86")
    set(pointer_size 4)
else()
    set(pointer_size 8)
endif()
ossl_windows_target("${OSSL_ARCH}" "${OSSL_ARCH}" "${pointer_size}" "${OSSL_HOST_ARCH}")
if(NOT OSSL_TARGET STREQUAL input_target OR NOT OSSL_DLL_SUFFIX STREQUAL input_suffix
    OR NOT OSSL_VCVARS_ARCH STREQUAL input_vcvars_arch OR NOT OSSL_USE_NASM STREQUAL input_use_nasm
    OR NOT OSSL_VCARGS MATCHES "^${OSSL_VCVARS_ARCH} "
    OR (OSSL_USE_NASM AND NOT OSSL_NASM) OR (NOT OSSL_USE_NASM AND OSSL_NASM))
    message(FATAL_ERROR "Windows OpenSSL architecture inputs disagree; reconfigure the parent project")
endif()
if(NOT OSSL_BACKEND MATCHES "^(nmake|jom)$" OR NOT "${OSSL_JOBS}" MATCHES "^[1-8]$")
    message(FATAL_ERROR "Missing or invalid OpenSSL make backend/jobs; reconfigure the parent project")
endif()
if((OSSL_BACKEND STREQUAL "jom" AND NOT OSSL_EXTRA_CFLAGS STREQUAL "/FS")
    OR (OSSL_BACKEND STREQUAL "nmake" AND (OSSL_EXTRA_CFLAGS OR NOT OSSL_JOBS EQUAL 1)))
    message(FATAL_ERROR "Unexpected backend compile flags or concurrency; reconfigure the parent project")
endif()
if((MODE STREQUAL "TEST" OR MODE STREQUAL "TEST_FULL") AND
    (NOT OSSL_SOURCE_LAYOUT STREQUAL "full" OR NOT OSSL_BUILD_TESTS OR NOT OSSL_BUILD_DEMOS))
    message(FATAL_ERROR "Official tests require a complete, test/demo-enabled source configuration")
endif()
ossl_configure_options("${OSSL_PROFILE}" "${OSSL_BUILD_TESTS}" "${OSSL_BUILD_DEMOS}" expected_options)
if(NOT OSSL_OPTIONS STREQUAL expected_options)
    message(FATAL_ERROR "OpenSSL profile options changed; reconfigure the parent project")
endif()
ossl_validate_source("${OSSL_SOURCE}" "${OSSL_SOURCE_LAYOUT}" "${OSSL_PROFILE}"
    "${OSSL_BUILD_TESTS}" "${OSSL_BUILD_DEMOS}" source_hash unused)
if(OSSL_BUNDLED_SOURCE)
    ossl_validate_bundled_source("${OSSL_BUNDLED_SOURCE}" bundled_hash unused)
    if(NOT bundled_hash STREQUAL source_hash)
        message(FATAL_ERROR "Bundled OpenSSL input and prepared snapshot identities differ; reconfigure the parent project")
    endif()
endif()
ossl_adapter_hash(adapter_hash)
if(NOT source_hash STREQUAL OSSL_SOURCE_HASH OR NOT adapter_hash STREQUAL OSSL_ADAPTER_HASH)
    message(FATAL_ERROR "OpenSSL source or adapter identity changed; reconfigure the parent project before building")
endif()
# Some official Windows generated dependencies do not quote a source path that
# contains spaces. Use a byte-identical, private full snapshot adjacent to build/
# so upstream emits ../source paths. Never patch its files or generated rules.
set(build_source "${OSSL_ROOT}/source")
if(NOT EXISTS "${build_source}")
    file(COPY "${OSSL_SOURCE}/" DESTINATION "${build_source}")
endif()
ossl_validate_source("${build_source}" "${OSSL_SOURCE_LAYOUT}" "${OSSL_PROFILE}"
    "${OSSL_BUILD_TESTS}" "${OSSL_BUILD_DEMOS}" mirror_hash unused)
if(NOT mirror_hash STREQUAL OSSL_SOURCE_HASH)
    message(FATAL_ERROR "Private OpenSSL source snapshot changed; use a fresh work root")
endif()
string(REPLACE "\n" ";" records "${OSSL_TOOL_RECORDS}")
foreach(record IN LISTS records)
    if(record MATCHES "^([0-9a-f]+)  (.+)$")
        set(expected "${CMAKE_MATCH_1}")
        set(path "${CMAKE_MATCH_2}")
        if(NOT EXISTS "${path}")
            message(FATAL_ERROR "OpenSSL tool missing; reconfigure: ${path}")
        endif()
        file(SHA256 "${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "OpenSSL tool identity changed; reconfigure: ${path}")
        endif()
    endif()
endforeach()
set(configuration_valid FALSE)
if(EXISTS "${OSSL_ROOT}/build/Makefile" AND EXISTS "${OSSL_ROOT}/build/configdata.pm"
    AND EXISTS "${OSSL_ROOT}/configured-identity.txt")
    file(SHA256 "${OSSL_ROOT}/build/Makefile" make_hash)
    file(SHA256 "${OSSL_ROOT}/build/configdata.pm" config_hash)
    file(READ "${OSSL_ROOT}/configured-identity.txt" configured)
    if(configured STREQUAL "${OSSL_ID}\n${make_hash}\n${config_hash}\n")
        set(configuration_valid TRUE)
    endif()
endif()
if(MODE STREQUAL "BOOTSTRAP" AND stage_valid AND configuration_valid
    AND NOT EXISTS "${OSSL_ROOT}/failed" AND NOT EXISTS "${OSSL_ROOT}/running")
    ossl_inventory("${OSSL_STAGE}" hash unused)
    file(WRITE "${OSSL_ROOT}/ready" "${OSSL_ID}\n${hash}\n")
    message(STATUS "OpenSSL ${OSSL_CONFIG} stage already verified")
    return()
endif()
file(MAKE_DIRECTORY "${OSSL_ROOT}/build" "${OSSL_ROOT}/logs")
string(TIMESTAMP now "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 6 ALPHABET 0123456789abcdef nonce)
set(log_root "${OSSL_ROOT}/logs/${now}-${nonce}-${MODE}")
file(MAKE_DIRECTORY "${log_root}")
if(EXISTS "${OSSL_ROOT}/running")
    # A killed parent cannot execute an error handler. An interrupted official
    # rule may leave a truncated output, so recover as for a failed make.
    file(WRITE "${OSSL_ROOT}/failed" "Interrupted OpenSSL invocation\n")
endif()
if(NOT configuration_valid AND EXISTS "${OSSL_ROOT}/build/configdata.pm")
    file(WRITE "${OSSL_ROOT}/failed" "Configuration identity missing or changed\n")
endif()
if(EXISTS "${OSSL_ROOT}/failed" AND EXISTS "${OSSL_ROOT}/build")
    # A failed make can leave truncated generated files that look up to date.
    # Preserve them for diagnosis and restart only this identity's build tree.
    file(REAL_PATH "${OSSL_ROOT}" checked_root)
    file(REAL_PATH "${OSSL_ROOT}/build" checked_build)
    if(NOT checked_build STREQUAL "${checked_root}/build" OR IS_SYMLINK "${OSSL_ROOT}/build")
        message(FATAL_ERROR "Refusing recovery outside the isolated OpenSSL build root")
    endif()
    file(RENAME "${checked_build}" "${checked_root}/failed-build-${now}-${nonce}")
    file(MAKE_DIRECTORY "${OSSL_ROOT}/build")
endif()
file(WRITE "${OSSL_ROOT}/running" "${MODE}\n${log_root}\n")
get_filename_component(perl_dir "${OSSL_PERL}" DIRECTORY)
set(tool_path "${perl_dir};%PATH%")
if(OSSL_USE_NASM)
    get_filename_component(nasm_dir "${OSSL_NASM}" DIRECTORY)
    set(tool_path "${nasm_dir};${tool_path}")
endif()
set(environment "@echo off\nsetlocal\ncall \"${OSSL_VCVARS}\" ${OSSL_VCARGS} >nul\nif errorlevel 1 exit /b 1\nset \"PATH=${tool_path}\"\nset LC_ALL=C\nset LC_CTYPE=C\nset LANG=C\nset PERL5LIB=\nset PERL5OPT=\nset NASMENV=\nset OPENSSL_LOCAL_CONFIG_DIR=\nset OPENSSL_CONF=\nset OPENSSL_MODULES=\nset OPENSSL_ENGINES=\nset CL=\nset _CL_=\nset LINK=\nset _LINK_=\nset CFLAGS=\nset CPPFLAGS=\nset LDFLAGS=\nset CC=\nset AS=\nset AR=\nset MAKE=\nset MAKEFLAGS=\nset JOMFLAGS=\nset _JOMSRVKEY_=\nset _JOMJOBCOUNT_=\nset HARNESS_JOBS=1\n")
if(MODE STREQUAL "TEST_FULL")
    string(APPEND environment "set TESTS=\nset TESTS_EXCLUDE=\nset HARNESS_SKIP=\nset HARNESS_OPTIONS=\n")
endif()
function(ossl_run name)
    set(command "")
    foreach(arg IN LISTS ARGN)
        ossl_safe_value("${arg}")
        string(APPEND command " \"${arg}\"")
    endforeach()
    set(script "${log_root}/${name}.cmd")
    # MSVC otherwise shares its PDB service across unrelated builds. Give this
    # command job its own endpoint so cancellation cannot kill another build's
    # service or reconnect to one terminated by an earlier command.
    string(SHA256 pdb_endpoint "${log_root}\n${name}")
    string(SUBSTRING "${pdb_endpoint}" 0 32 pdb_endpoint)
    file(WRITE "${script}" "${environment}set _MSPDBSRV_ENDPOINT_=cc_${pdb_endpoint}\n${command}\nexit /b %errorlevel%\n")
    message(STATUS "OpenSSL ${OSSL_CONFIG}: ${name} (${log_root}/${name}.log)")
    # Native Perl 5.42 can crash when spawned by nmake with inherited disk-file
    # standard handles. Capture both streams through pipes, then persist them.
    string(TIMESTAMP started "%s" UTC)
    execute_process(COMMAND "${OSSL_POWERSHELL}" -NoProfile -NonInteractive -ExecutionPolicy Bypass
        -File "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunWindowsCommand.ps1" -Script "${script}"
        WORKING_DIRECTORY "${OSSL_ROOT}/build"
        RESULT_VARIABLE result OUTPUT_VARIABLE command_output ERROR_VARIABLE command_error)
    string(TIMESTAMP finished "%s" UTC)
    math(EXPR elapsed "${finished}-${started}")
    file(WRITE "${log_root}/${name}.log" "${command_output}")
    file(WRITE "${log_root}/${name}.stderr.log" "${command_error}")
    file(APPEND "${log_root}/commands.txt" "${name}: ${command}\nstdout=${name}.log\nstderr=${name}.stderr.log\npdb_endpoint=cc_${pdb_endpoint}\nexit=${result}\nelapsed_seconds=${elapsed}\n")
    if(NOT result EQUAL 0)
        file(WRITE "${OSSL_ROOT}/failed" "${name}\n${log_root}\nexit=${result}\n")
        message(FATAL_ERROR "OpenSSL ${name} failed (${result}); see ${log_root}/${name}.log and .stderr.log; ready marker removed")
    endif()
endfunction()

function(ossl_make name target jobs)
    if(OSSL_BACKEND STREQUAL "jom")
        # jom predefines MAKE as its own absolute, correctly quoted executable.
        # Its recursive instances share one jobserver. Do not append -j to MAKE
        # or inject independent per-submake concurrency through the environment.
        ossl_run("${name}" "${OSSL_MAKE}" /nologo "-j${jobs}" "${target}" ${ARGN})
    else()
        ossl_run("${name}" "${OSSL_MAKE}" /nologo "${target}" ${ARGN})
    endif()
endfunction()

if(NOT EXISTS "${OSSL_ROOT}/build/configdata.pm" OR NOT EXISTS "${OSSL_ROOT}/build/Makefile")
    string(TOLOWER "${OSSL_CONFIG}" config)
    set(assembler_options "")
    if(OSSL_USE_NASM)
        set(assembler_options AS=nasm)
    endif()
    ossl_run(configure "${OSSL_PERL}" "${build_source}/Configure" "${OSSL_TARGET}" shared "--${config}"
        "--prefix=${OSSL_STAGE}" "--openssldir=${OSSL_STAGE}/ssl" "--libdir=lib" ${OSSL_OPTIONS} ${OSSL_EXTRA_CFLAGS} ${assembler_options})
    file(SHA256 "${OSSL_ROOT}/build/Makefile" make_hash)
    file(SHA256 "${OSSL_ROOT}/build/configdata.pm" config_hash)
    file(WRITE "${OSSL_ROOT}/configured-identity.txt" "${OSSL_ID}\n${make_hash}\n${config_hash}\n")
endif()
file(READ "${OSSL_ROOT}/build/Makefile" makefile)
if(OSSL_CONFIG STREQUAL "Debug")
    set(crt "/MDd")
else()
    set(crt "/MD")
endif()
if(NOT makefile MATCHES "CFLAGS=[^\n]*${crt}([ \r\n]|$)")
    message(FATAL_ERROR "Official Makefile does not select expected ${crt} CRT")
endif()
if((OSSL_USE_NASM AND NOT makefile MATCHES "AS=\"nasm\"")
    OR (NOT OSSL_USE_NASM AND makefile MATCHES "AS=\"nasm(w)?\""))
    message(FATAL_ERROR "Official Makefile assembler disagrees with ${OSSL_TARGET}")
endif()
if(makefile MATCHES "(^|\n)MAKE[ \t]*=")
    message(FATAL_ERROR "Official Makefile overrides the selected backend's recursive MAKE macro")
endif()
if(OSSL_BACKEND STREQUAL "jom" AND NOT makefile MATCHES "CFLAGS=[^\n]*/FS([ \r\n]|$)")
    message(FATAL_ERROR "Parallel OpenSSL Makefile is missing synchronous PDB writes (/FS)")
endif()
file(WRITE "${log_root}/backend.txt" "backend=${OSSL_BACKEND}\nmake=${OSSL_MAKE}\nversion=${OSSL_MAKE_VERSION}\nparallel_jobs=${OSSL_JOBS}\nserial_jobs=1\nextra_cflags=${OSSL_EXTRA_CFLAGS}\nrecursive_make=builtin absolute executable, shared jom jobserver\n")
ossl_make(build-generated build_generated 1)
ossl_make(build-libs build_libs "${OSSL_JOBS}")
ossl_make(build-modules build_modules "${OSSL_JOBS}")
ossl_make(install-dev install_dev 1)
ossl_make(install-modules install_modules 1)
ossl_make(install-engines install_engines 1)
foreach(file include/openssl/configuration.h include/openssl/opensslv.h include/openssl/ssl.h
    lib/libcrypto.lib lib/libssl.lib "bin/libcrypto-3${OSSL_DLL_SUFFIX}.dll" "bin/libssl-3${OSSL_DLL_SUFFIX}.dll" lib/ossl-modules/legacy.dll)
    if(NOT EXISTS "${OSSL_STAGE}/${file}")
        message(FATAL_ERROR "Incomplete OpenSSL stage: ${file}")
    endif()
endforeach()
file(GLOB public_headers "${build_source}/include/openssl/*.h" "${OSSL_ROOT}/build/include/openssl/*.h")
foreach(header IN LISTS public_headers)
    get_filename_component(name "${header}" NAME)
    if(name MATCHES "^__DECC_")
        continue()
    endif()
    if(NOT EXISTS "${OSSL_STAGE}/include/openssl/${name}")
        message(FATAL_ERROR "Public OpenSSL header was not installed: ${name}")
    endif()
endforeach()
file(SHA256 "${OSSL_STAGE}/include/openssl/configuration.h" staged)
file(SHA256 "${OSSL_ROOT}/build/include/openssl/configuration.h" generated)
if(NOT staged STREQUAL generated)
    message(FATAL_ERROR "Generated and staged OpenSSL configuration headers differ")
endif()
file(READ "${OSSL_STAGE}/include/openssl/configuration.h" feature_header)
ossl_run(inspect-options "${OSSL_PERL}" "${CMAKE_CURRENT_LIST_DIR}/CheckOpenSSLOptions.pl" ${OSSL_OPTIONS})
foreach(option IN LISTS OSSL_OPTIONS)
    # Configure deliberately excludes fips from openssl_feature_defines.
    if(option STREQUAL "no-fips")
        continue()
    endif()
    string(REPLACE "-" "_" macro "${option}")
    string(TOUPPER "OPENSSL_${macro}" macro)
    if(NOT feature_header MATCHES "#[ \t]*define[ \t]+${macro}([ \r\n]|$)")
        message(FATAL_ERROR "OpenSSL profile option is missing from generated headers: ${option}")
    endif()
endforeach()
if(MODE STREQUAL "TEST" OR MODE STREQUAL "TEST_FULL")
    # Full upstream apps/tests stay enabled. This deliberately builds the test
    # tools with the same configuration and feature options as the staged libs.
    ossl_make(build-tests build_programs 1)
    if(MODE STREQUAL "TEST_FULL")
        ossl_make(official-tests test 1)
    else()
        ossl_make(official-tests test 1
            "TESTS=test_sha test_aesgcm test_hmac test_rand test_evp test_evp_kdf test_evp_fetch_prov test_x509 test_pkcs12 test_sslapi")
    endif()
endif()
ossl_inventory("${OSSL_STAGE}" stage_hash stage_inventory)
# Upstream add-depends.pl appends dependencies to Makefile during normal make.
file(SHA256 "${OSSL_ROOT}/build/Makefile" make_hash)
file(SHA256 "${OSSL_ROOT}/build/configdata.pm" config_hash)
file(WRITE "${OSSL_ROOT}/configured-identity.txt" "${OSSL_ID}\n${make_hash}\n${config_hash}\n")
file(WRITE "${OSSL_ROOT}/stage-manifest.sha256" "${stage_inventory}")
file(WRITE "${log_root}/result.txt" "identity=${OSSL_ID}\nsource=${source_hash}\nadapter=${adapter_hash}\nstage=${stage_hash}\nconfiguration=${OSSL_CONFIG}\narchitecture=${OSSL_ARCH}\ntarget=${OSSL_TARGET}\nprofile=${OSSL_PROFILE}\noptions=${OSSL_OPTIONS}\nCRT=${crt}\nmode=${MODE}\nresult=ready\n")
file(WRITE "${OSSL_ROOT}/ready.tmp" "${OSSL_ID}\n${stage_hash}\n")
file(RENAME "${OSSL_ROOT}/ready.tmp" "${OSSL_ROOT}/ready")
file(REMOVE "${OSSL_ROOT}/failed")
file(REMOVE "${OSSL_ROOT}/running")
message(STATUS "OpenSSL ${OSSL_CONFIG} ready: ${OSSL_STAGE}")
