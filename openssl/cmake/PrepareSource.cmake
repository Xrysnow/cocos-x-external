cmake_minimum_required(VERSION 3.28)
include("${CMAKE_CURRENT_LIST_DIR}/OpenSSLCommon.cmake")
foreach(var ARCHIVE DESTINATION)
    if(NOT DEFINED ${var} OR NOT IS_ABSOLUTE "${${var}}")
        message(FATAL_ERROR "Pass -D${var}=<absolute local path>")
    endif()
    ossl_safe_value("${${var}}")
endforeach()
if(EXISTS "${DESTINATION}")
    message(FATAL_ERROR "Refusing to overwrite existing snapshot: ${DESTINATION}")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/../source-manifest.json" manifest)
string(JSON expected GET "${manifest}" archive_sha256)
file(SHA256 "${ARCHIVE}" actual)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "OpenSSL archive SHA256 does not match pinned input")
endif()
# Official fixed archive is extracted only after its identity has been checked.
file(MAKE_DIRECTORY "${DESTINATION}")
file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${DESTINATION}")
set(source "${DESTINATION}/openssl-3.5.9")
ossl_inventory("${source}" hash inventory)
file(WRITE "${DESTINATION}/source-files.sha256" "${inventory}")
file(WRITE "${DESTINATION}/source-identity.txt" "archive=${actual}\nsource=${hash}\n")
message(STATUS "Full unmodified source: ${source} (${hash})")
