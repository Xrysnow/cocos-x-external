include_guard(GLOBAL)

# Pure mappings: usable with assumed parent CMake variables under cmake -P.
# No host tools, filesystem probes or generated files belong in this helper.
function(ossl_portable_configurations out)
    if(CMAKE_CONFIGURATION_TYPES)
        set(configurations "${CMAKE_CONFIGURATION_TYPES}")
    else()
        set(configurations "${CMAKE_BUILD_TYPE}")
    endif()
    if(NOT configurations)
        message(FATAL_ERROR "OpenSSL requires Debug or Release; set CMAKE_BUILD_TYPE, or restrict CMAKE_CONFIGURATION_TYPES to Debug;Release")
    endif()
    foreach(config IN LISTS configurations)
        if(NOT config MATCHES "^(Debug|Release)$")
            message(FATAL_ERROR "Unsupported OpenSSL configuration '${config}'; set CMAKE_CONFIGURATION_TYPES=Debug;Release (Xcode/Ninja Multi-Config), or CMAKE_BUILD_TYPE=Debug|Release")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES configurations)
    set(${out} "${configurations}" PARENT_SCOPE)
endfunction()

# Outputs <prefix>_{TARGET,ARCH,FORMAT,ELF_CLASS,ELF_MACHINE,TRIPLE,SDK_NAME,
# DEPLOYMENT_FLAG,PLATFORM}. TRIPLE is the NDK driver stem on Android and the
# complete deployment-qualified Clang target on Apple. TARGET names are from
# bundled OpenSSL Configurations/{10-main,15-android,15-ios}.conf.
function(ossl_portable_target prefix)
    set(target "")
    set(arch "")
    set(format ELF)
    set(elf_class "")
    set(elf_machine "")
    set(triple "")
    set(sdk_name "")
    set(deployment_flag "")
    set(platform "")
    if(CMAKE_SYSTEM_NAME STREQUAL "Android")
        set(platform android)
        if(CMAKE_ANDROID_ARCH_ABI STREQUAL "arm64-v8a")
            set(target android-arm64)
            set(arch aarch64)
            set(triple aarch64-linux-android)
        elseif(CMAKE_ANDROID_ARCH_ABI STREQUAL "x86_64")
            set(target android-x86_64)
            set(arch x86_64)
            set(triple x86_64-linux-android)
        elseif(CMAKE_ANDROID_ARCH_ABI STREQUAL "armeabi-v7a")
            set(target android-arm)
            set(arch armv7)
            set(triple armv7a-linux-androideabi)
        elseif(CMAKE_ANDROID_ARCH_ABI STREQUAL "x86")
            set(target android-x86)
            set(arch i686)
            set(triple i686-linux-android)
        else()
            message(FATAL_ERROR "Unsupported OpenSSL Android ABI '${CMAKE_ANDROID_ARCH_ABI}'; use arm64-v8a, x86_64, armeabi-v7a or x86")
        endif()
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(platform linux)
        string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" processor)
        if(processor MATCHES "^(x86_64|amd64)$")
            set(target linux-x86_64)
            set(arch x86_64)
        elseif(processor MATCHES "^(aarch64|arm64)$")
            set(target linux-aarch64)
            set(arch aarch64)
        elseif(processor MATCHES "^(i[3-6]86|x86)$")
            set(target linux-x86)
            set(arch i686)
        elseif(processor MATCHES "^(armv7([al]|-a)?|armhf)$")
            # Upstream deliberately leaves -march to the parent compiler.
            set(target linux-armv4)
            set(arch armv7)
        else()
            message(FATAL_ERROR "Unsupported OpenSSL Linux processor '${CMAKE_SYSTEM_PROCESSOR}'; provide an explicit supported target toolchain (x86_64, aarch64, i686 or armv7)")
        endif()
    elseif(CMAKE_SYSTEM_NAME MATCHES "^(Darwin|iOS|tvOS)$")
        set(format MachO)
        set(arch "${CMAKE_OSX_ARCHITECTURES}")
        if(NOT arch OR arch MATCHES ";")
            message(FATAL_ERROR "OpenSSL Apple builds require one explicit CMAKE_OSX_ARCHITECTURES value; build each architecture separately, universal merging is not implemented")
        endif()
        if(NOT CMAKE_OSX_SYSROOT)
            message(FATAL_ERROR "OpenSSL Apple builds require an explicit CMAKE_OSX_SYSROOT SDK name or SDK path")
        endif()
        if(NOT CMAKE_OSX_DEPLOYMENT_TARGET MATCHES "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$")
            message(FATAL_ERROR "OpenSSL Apple builds require an explicit numeric CMAKE_OSX_DEPLOYMENT_TARGET")
        endif()
        string(REGEX REPLACE "/+$" "" sdk "${CMAKE_OSX_SYSROOT}")
        get_filename_component(sdk "${sdk}" NAME)
        string(TOLOWER "${sdk}" sdk)
        if(sdk MATCHES "^macosx[0-9.]*(\\.sdk)?$")
            set(sdk_name macosx)
            set(platform macos)
            set(os macosx)
            set(deployment_flag "-mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
        elseif(sdk MATCHES "^iphoneos[0-9.]*(\\.sdk)?$")
            set(sdk_name iphoneos)
            set(platform ios)
            set(os ios)
            set(deployment_flag "-miphoneos-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
        elseif(sdk MATCHES "^iphonesimulator[0-9.]*(\\.sdk)?$")
            set(sdk_name iphonesimulator)
            set(platform ios-simulator)
            set(os ios)
            set(deployment_flag "-mios-simulator-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
        elseif(sdk MATCHES "^appletvos[0-9.]*(\\.sdk)?$")
            set(sdk_name appletvos)
            set(platform tvos)
            set(os tvos)
            set(deployment_flag "-mtvos-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
        elseif(sdk MATCHES "^appletvsimulator[0-9.]*(\\.sdk)?$")
            set(sdk_name appletvsimulator)
            set(platform tvos-simulator)
            set(os tvos)
            set(deployment_flag "-mtvos-simulator-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
        else()
            message(FATAL_ERROR "Unsupported OpenSSL Apple SDK '${CMAKE_OSX_SYSROOT}'")
        endif()
        # Older project iOS toolchains also label AppleTV as CMAKE_SYSTEM_NAME=iOS.
        if((CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND NOT platform STREQUAL "macos")
            OR (CMAKE_SYSTEM_NAME STREQUAL "iOS" AND platform STREQUAL "macos")
            OR (CMAKE_SYSTEM_NAME STREQUAL "tvOS" AND NOT platform MATCHES "^tvos"))
            message(FATAL_ERROR "OpenSSL Apple SDK '${sdk_name}' disagrees with CMAKE_SYSTEM_NAME=${CMAKE_SYSTEM_NAME}")
        endif()
        set(triple "${arch}-apple-${os}${CMAKE_OSX_DEPLOYMENT_TARGET}")
        if(platform MATCHES "-simulator$")
            string(APPEND triple "-simulator")
        endif()
        if(platform STREQUAL "ios")
            if(arch STREQUAL "arm64")
                set(target ios64-xcrun)
            elseif(arch STREQUAL "armv7")
                set(target ios-xcrun)
            endif()
        elseif(platform STREQUAL "ios-simulator")
            if(arch MATCHES "^(arm64|x86_64|i386)$")
                set(target "iossimulator-${arch}-xcrun")
            endif()
        elseif(platform MATCHES "^(macos|tvos|tvos-simulator)$")
            if(arch MATCHES "^(arm64|x86_64)$" AND NOT (platform STREQUAL "tvos" AND NOT arch STREQUAL "arm64"))
                # The bundled OpenSSL has no tvOS target. Darwin provides the correct Mach-O
                # assembly/bignum ABI; explicit -target/-arch/-isysroot below
                # select AppleTV OS, simulator and minimum version, not macOS.
                set(target "darwin64-${arch}-cc")
            endif()
        endif()
        if(NOT target)
            message(FATAL_ERROR "Unsupported OpenSSL ${sdk_name} architecture '${arch}'")
        endif()
    else()
        message(FATAL_ERROR "Unsupported OpenSSL portable system '${CMAKE_SYSTEM_NAME}'; no prebuilt fallback")
    endif()
    if(format STREQUAL "ELF")
        if(arch STREQUAL "aarch64")
            set(elf_class ELF64)
            set(elf_machine AArch64)
        elseif(arch STREQUAL "x86_64")
            set(elf_class ELF64)
            set(elf_machine "Advanced Micro Devices X86-64")
        elseif(arch STREQUAL "i686")
            set(elf_class ELF32)
            set(elf_machine "Intel 80386")
        elseif(arch STREQUAL "armv7")
            set(elf_class ELF32)
            set(elf_machine ARM)
        endif()
    endif()
    if(CMAKE_SIZEOF_VOID_P)
        if(arch MATCHES "^(aarch64|arm64|x86_64)$")
            set(pointer_size 8)
        else()
            set(pointer_size 4)
        endif()
        if(NOT CMAKE_SIZEOF_VOID_P EQUAL pointer_size)
            message(FATAL_ERROR "OpenSSL architecture '${arch}' disagrees with the parent compiler pointer size; select an explicit matching target toolchain")
        endif()
    endif()
    foreach(name TARGET ARCH FORMAT ELF_CLASS ELF_MACHINE TRIPLE SDK_NAME DEPLOYMENT_FLAG PLATFORM)
        string(TOLOWER "${name}" value)
        set(${prefix}_${name} "${${value}}" PARENT_SCOPE)
    endforeach()
endfunction()
