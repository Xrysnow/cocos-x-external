include_guard(GLOBAL)

# A retained_files entry keeps only these unmodified files and their parent
# directories within its subtree. No glob or upstream build.info patch is used.
function(ossl_prune_keep relative is_directory manifest out)
    foreach(field excluded_directories excluded_empty_directories excluded_files)
        string(JSON count LENGTH "${manifest}" ${field})
        if(count GREATER 0)
            math(EXPR last "${count}-1")
            foreach(index RANGE 0 ${last})
                string(JSON excluded GET "${manifest}" ${field} ${index})
                cmake_path(IS_PREFIX excluded "${relative}" NORMALIZE skip)
                if(skip)
                    set(${out} FALSE PARENT_SCOPE)
                    return()
                endif()
            endforeach()
        endif()
    endforeach()
    string(JSON count LENGTH "${manifest}" retained_files)
    if(count GREATER 0)
        math(EXPR last "${count}-1")
        foreach(index RANGE 0 ${last})
            string(JSON subtree MEMBER "${manifest}" retained_files ${index})
            cmake_path(IS_PREFIX subtree "${relative}" NORMALIZE inside)
            if(NOT inside)
                continue()
            endif()
            string(JSON files LENGTH "${manifest}" retained_files "${subtree}")
            math(EXPR last_file "${files}-1")
            foreach(file_index RANGE 0 ${last_file})
                string(JSON file GET "${manifest}" retained_files "${subtree}" ${file_index})
                set(file "${subtree}/${file}")
                if(is_directory)
                    cmake_path(IS_PREFIX relative "${file}" NORMALIZE keep)
                elseif(relative STREQUAL file)
                    set(keep TRUE)
                else()
                    set(keep FALSE)
                endif()
                if(keep)
                    set(${out} TRUE PARENT_SCOPE)
                    return()
                endif()
            endforeach()
            set(${out} FALSE PARENT_SCOPE)
            return()
        endforeach()
    endif()
    set(${out} TRUE PARENT_SCOPE)
endfunction()
