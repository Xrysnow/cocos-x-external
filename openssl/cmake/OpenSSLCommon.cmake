include_guard(GLOBAL)

# Values also cross cmd.exe and the generated input file. Spaces are supported;
# shell metacharacters and CMake list delimiters are deliberately rejected.
function(ossl_safe_value value)
    if("${value}" MATCHES "[\r\n\"%;!&|<>^]" OR "${value}" MATCHES "\\]===\\]")
        message(FATAL_ERROR "Unsupported character in OpenSSL input: ${value}")
    endif()
endfunction()

function(ossl_inventory root out_hash out_text)
    file(GLOB_RECURSE files LIST_DIRECTORIES TRUE RELATIVE "${root}" "${root}/*" "${root}/.*")
    list(SORT files)
    set(inventory "")
    foreach(file IN LISTS files)
        ossl_safe_value("${file}")
        if(IS_SYMLINK "${root}/${file}")
            message(FATAL_ERROR "OpenSSL input must not contain symlinks: ${file}")
        endif()
        if(IS_DIRECTORY "${root}/${file}")
            continue()
        endif()
        file(SHA256 "${root}/${file}" hash)
        string(APPEND inventory "${hash}  ${file}\n")
    endforeach()
    string(SHA256 hash "${inventory}")
    set(${out_hash} "${hash}" PARENT_SCOPE)
    set(${out_text} "${inventory}" PARENT_SCOPE)
endfunction()

function(ossl_adapter_hash out_hash)
    file(GLOB files "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/*.cmake" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/*.ps1")
    list(APPEND files "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../source-manifest.json"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../cmake/BuildOpenSSL.cmake")
    list(SORT files)
    set(identity "")
    foreach(file IN LISTS files)
        file(SHA256 "${file}" hash)
        string(APPEND identity "${file}=${hash}\n")
    endforeach()
    string(SHA256 hash "${identity}")
    set(${out_hash} "${hash}" PARENT_SCOPE)
endfunction()

function(ossl_write_if_changed path content)
    set(old "")
    if(EXISTS "${path}")
        file(READ "${path}" old)
    endif()
    if(NOT old STREQUAL content)
        file(WRITE "${path}" "${content}")
    endif()
endfunction()

function(ossl_stage_valid out)
    set(valid FALSE)
    if(EXISTS "${OSSL_ROOT}/ready" AND EXISTS "${OSSL_ROOT}/stage-manifest.sha256")
        file(READ "${OSSL_ROOT}/ready" ready)
        ossl_inventory("${OSSL_STAGE}" hash inventory)
        file(READ "${OSSL_ROOT}/stage-manifest.sha256" expected)
        if(ready STREQUAL "${OSSL_ID}\n${hash}\n" AND inventory STREQUAL expected)
            set(valid TRUE)
        endif()
    endif()
    set(${out} "${valid}" PARENT_SCOPE)
endfunction()
