include_guard(GLOBAL)

# Pure mappings: no compiler, tools, source tree or filesystem access is needed.
function(ossl_windows_normalize_architecture value out)
    string(TOLOWER "${value}" architecture)
    if(architecture MATCHES "^(win32|x86|i[3-6]86)$")
        set(architecture x86)
    elseif(architecture MATCHES "^(x64|amd64|x86_64)$")
        set(architecture x64)
    elseif(architecture MATCHES "^(arm64|aarch64)$")
        set(architecture arm64)
    else()
        message(FATAL_ERROR "Unsupported Windows OpenSSL architecture: ${value}; expected Win32/x86, x64 or ARM64")
    endif()
    set(${out} "${architecture}" PARENT_SCOPE)
endfunction()

# Inputs are the parent compiler architecture, VS platform, pointer size and
# compiler host architecture (Hostx86/Hostx64/Hostarm64), respectively.
function(ossl_windows_target compiler_arch generator_platform pointer_size host_arch)
    string(REGEX REPLACE ",.*$" "" platform "${generator_platform}")
    set(architecture "")
    if(NOT "${compiler_arch}" STREQUAL "")
        ossl_windows_normalize_architecture("${compiler_arch}" architecture)
    endif()
    if(NOT platform STREQUAL "")
        ossl_windows_normalize_architecture("${platform}" platform_arch)
        if(architecture AND NOT architecture STREQUAL platform_arch)
            message(FATAL_ERROR "Windows OpenSSL compiler architecture ${compiler_arch} disagrees with generator platform ${generator_platform}")
        endif()
        set(architecture "${platform_arch}")
    endif()
    if(NOT architecture)
        message(FATAL_ERROR "Windows OpenSSL requires an explicit parent compiler architecture or Visual Studio platform")
    endif()
    ossl_windows_normalize_architecture("${host_arch}" host)
    set(use_nasm TRUE)
    if(architecture STREQUAL "x86")
        set(target VC-WIN32)
        set(size 4)
        set(suffix "")
        set(vc_target x86)
    elseif(architecture STREQUAL "x64")
        set(target VC-WIN64A)
        set(size 8)
        set(suffix -x64)
        set(vc_target amd64)
    else()
        # Official Configurations/50-win-onecore.conf uses generic C on ARM64.
        set(target VC-WIN64-ARM)
        set(size 8)
        set(suffix -arm64)
        set(vc_target arm64)
        set(use_nasm FALSE)
    endif()
    if(NOT "${pointer_size}" STREQUAL "${size}")
        message(FATAL_ERROR "Windows OpenSSL ${architecture} requires ${size}-byte pointers; parent reports ${pointer_size}")
    endif()
    set(vc_host "${host}")
    if(host STREQUAL "x64")
        set(vc_host amd64)
    endif()
    if(vc_host STREQUAL vc_target)
        set(vcvars_arch "${vc_host}")
    else()
        set(vcvars_arch "${vc_host}_${vc_target}")
    endif()
    set(OSSL_ARCH "${architecture}" PARENT_SCOPE)
    set(OSSL_HOST_ARCH "${host}" PARENT_SCOPE)
    set(OSSL_TARGET "${target}" PARENT_SCOPE)
    set(OSSL_VCVARS_ARCH "${vcvars_arch}" PARENT_SCOPE)
    set(OSSL_DLL_SUFFIX "${suffix}" PARENT_SCOPE)
    set(OSSL_USE_NASM "${use_nasm}" PARENT_SCOPE)
endfunction()
